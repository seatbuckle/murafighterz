;---------------------------------------------------------------------------
; STUN
[Statedef 5000]
type = A
movetype = H
physics = N
anim = 5000
ctrl = 0
velset = 0,0

[State Stopthat]
type = PosSet
trigger1 = pos y > 0
y = 0

[State RoarsOfPain]
type = PlaySnd
triggerall = alive
trigger1 = !time
value = s0,3
channel = 0

[State -3, FLASHY]
type = PalFX
triggerall = alive
trigger1 = !(time%2)
time = 1
add = 256,256,256
mul = 255,255,255

[State Next]
type = ChangeState
trigger1 = time>=40
trigger2 = !alive
value = 5050;*!alive+(!!var(0)+(var(0)>=2))*alive

;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
;---------------------------------------------------------------------------
; FALL
[Statedef 5050]
type = A
movetype = H
physics = N
ctrl = 0
velset = 0,0

[State RoarsOfPain]
type = PlaySnd
trigger1 = !time
value = s0,3
channel = 0

[State Kill]
type = LifeSet
trigger1 = -1
value = 0

[State Next]
type = ChangeState
trigger1 = 1
value = 5051+!(pos y)


[Statedef 5051]
type = A
movetype = H
physics = N
anim = 5000
ctrl = 0
velset = 0,0

[State -3, FLASHY]
type = PalFX
trigger1 = !(time%2)
time = 1
add = 256,256,256
mul = 255,255,255

[State ISAIDFALL]
type = Gravity
trigger1 = pos y

[State DEAD]
type = ChangeState
trigger1 = pos y >= 0
value = 5052


[Statedef 5052]
type = A
movetype = H
physics = N
anim = 5050
velset = 0,2
SprPriority = -4

[State Boom]
type = PlaySnd
trigger1 = !time
value = s2,5
volume = 128
[State KABOOM]
type = Explod
trigger1 = !time
anim = 7001
ID = 7001
pos = 0,-120
postype = p1
bindtime = 1
scale = 1,1
ownpal = 1
sprpriority = 4

[State GONE]
type = ChangeAnim
trigger1 = time=240
value = 9741
[State FALL]
type = PosSet
trigger1 = time=240
y = 0
[State FALL]
type = VelSet
trigger1 = time=240
y = 0

[State MoreRoarsOfPain]
type = PlaySnd
triggerall = time=[240,420]
trigger1 = !((time-240)%60)
value = s0,3-!(time-240)-((time-240)/60)
channel = 0

[State Die]
type = ChangeState
trigger1 = time >= 420
value = 5150


;---------------------------------------------------------------------------
; DEAD
[Statedef 5150]
type = L
movetype = H
physics = N
velset = 0,0
anim = 5150
SprPriority = -4

[State INCINERATED]
type = AssertSpecial
trigger1 = sysvar(1) = 1338
flag = invisible

[State FALL]
type = PosSet
trigger1 = !time
y = 0

[State NOTOUCHY]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Continue?
[Statedef 5500]
type = S
ctrl = 0
anim = 5300
velset = 0,0

[State 5500, 1] ;Use continue animation if available
type = ChangeAnim
trigger1 = !time
trigger1 = SelfAnimExist(5500)
value = 5500

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S
poweradd = -power

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = !roundsexisted
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = !roundsexisted
fvalue = 0

[State GetP3ID]
type = VarSet
triggerall = teammode = simul
trigger1 = P3name = "Kraidgief"
var(25) = ID<(partner,ID)

[State THEKID]
type = VarSet
triggerall = enemynear,name="IWBTG"
triggerall = enemynear,authorname="fhqwhgads7"
trigger1 = !(enemynear,teammode=simul)
trigger2 = enemynear(enemy,teammode=simul),name="IWBTG"
trigger2 = enemynear(enemy,teammode=simul),authorname="fhqwhgads7"
var(50) = 1

[State INTRO] ;Intro
type = ChangeState
trigger1 = 1
value = 190
