trigger1 = ((StateNo != [2000,2042]) && MoveType != H)
trigger1 = ((StateNo != [3000,3008]) && MoveType != H)
trigger1 = Var(53) = 1
var(52) = -3

[State 0, VarSet]
type = VarSet
trigger1 = Var(52)<=0
var(53) = 0

[State 0, VarSet]
type = VarSet
