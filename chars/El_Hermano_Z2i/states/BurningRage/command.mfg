;===========================================================================


;===========================================================================
; AI
;===========================================================================

;AI Jump
[State 0, ChangeState AI Jump]
type = ChangeState
triggerall = (AILevel>0 && AILevel <=8) && numenemy && roundstate=2 && StateType = S  
triggerall = Ctrl = 1
triggerall = ((P2BodyDist x != [-70,70])  && (P2StateType != S || P2StateType != C))
triggerall = !NumTarget(1001)
trigger1 = random <40*(AIlevel ** 2 / 64.0)
trigger1 = (StateNo = 20) && Time >15
trigger2 = p2bodydist x<140
trigger2 = P2MoveType = H && P2StateType = A
trigger2 = random <200*(AIlevel ** 2 / 64.0)
