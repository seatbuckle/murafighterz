[State 902, fvar reset]
type = VarSet
trigger1 = !AnimTime
fvar(9) = 0

[State 1302, TargetState]  ;Limiter state
type = TargetState
triggerall = Numtarget(1322)
trigger1 = movehit = 1
value = 1322
ID = 1322
ignorehitpause = 1
persistent = 0
 
[State 1302, TargetState]  ;New state
type = TargetState
triggerall = Numtarget(1302)
trigger1 = movehit = 1
value = 1320
ID = 1302
ignorehitpause = 1
persistent = 0

;Focus Limiter 2 Limiter
[State 0, Explod]
type = Explod
trigger1 = !NumExplod(1302)
trigger1 = NumTarget(1302)
anim = 1
ID = 1302
removetime = -1
removeongethit = 1
ignorehitpause = 1
 

;Dash Cancels upon movecontact
[State 1302, dash cancel backward]
type = ChangeState
trigger1 = time >= 8 && movehit && !AILevel
trigger1 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90001064)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90001016))
trigger2 = AILevel>=1 && movehit && random<150
value = Cond(P2Dist X < -12, 100, 105)
ignorehitpause = 1

[State 1302, dash cancel forward]
type = ChangeState
trigger1 = time >= 8 && movehit && !AILevel
trigger1 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90001016)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90001064))
trigger2 = AILevel>=1 && movehit && random<150
value = Cond(P2Dist X < -12, 105, 100)
ignorehitpause = 1

;Dash Cancels upon movecontact
[State 1302, dash cancel backward]
type = ChangeState
triggerall = P2Dist X >= -12
trigger1 = time >= 8 && moveguarded && !AILevel
trigger1 = (cond(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90001064)) || (cond(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90001016))
trigger2 = AILevel>=1 && moveguarded && random<150
value = 105
;ignorehitpause = 1


[State 902, end]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

