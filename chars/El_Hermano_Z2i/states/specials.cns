triggerall = !MoveContact && !MoveReversed
triggerall = P2stateno != [5020,5040]
triggerall = p2stateno != [154,155]
triggerall = p2statetype = A
trigger1 = (FVar(9) < 60)
attr = S, NA
damage= 32,0
animtype = Hard
guardflag = A
