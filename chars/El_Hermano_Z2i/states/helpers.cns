    ignorehitpause = 1

    [State 200, Play Anim]
    type = ChangeAnim
    triggerall =Anim=12005 || Anim = 12007 ;(2)would be the blur frame while (3) is the nonblur
    trigger1 = hitPauseTime = [1,5- (2 - var(15))] ;[1,10 - (5 - var(15))] means [1,10 {change the 10 to the hitpausetime} - (5 {change the 5 to how long it takes before you get to the frame you want the pause to stay on}- var(15))]
    value = anim
    elem = IfElse(AnimElemTime(10)<0,AnimElemNo(0)+1,1)
    ignorehitpause = 1

