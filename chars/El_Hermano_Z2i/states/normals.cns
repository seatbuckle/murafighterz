;---------------------------------------------------------------------------
; Taunt
[Statedef 195]
type = A
movetype = I
physics = N
ctrl = 0
;anim = 195
velset = 0,0
sprpriority = 2


[State 200, a]
type = ChangeAnim
triggerall = PrevStateNo != 9000
trigger1 = time = 0
value = 195

[State 0];Voice
Type=PlaySND
triggerall = PrevStateNo != 9000
Trigger1=!Time
Value=195,1
VolumeScale=200

[State 0]
Type=PosAdd
triggerall = PrevStateNo != 9000
Trigger1=Time<5
Y=-2


[State 0]
Type=PosAdd
Trigger1=Time>=44
Y=2

[State 0, VelSet]
type = VelSet
trigger1 = 1
x = 0
y = 0


[State 0]
Type=PlaySND
Trigger1=Pos Y>=0&&Vel Y>=0
Value=40,0
VolumeScale=100

[State 195, 2]
type = ChangeState
trigger1 = Pos Y>=0&&Vel Y>=0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; STAND LIGHT PUNCH
[StateDef 200]
type = S
movetype = A
physics = S
;anim = 200
ctrl = 0
velset = 0,0
sprpriority = 1
;;juggle = 7

[State 200, a]
type = ChangeAnim
trigger1 = PrevStateNo != 9000
trigger1 = time = 0
value = 200

[State Armor, Projectile]
type = Projectile
trigger1 = AnimElemTime(2)>=3 && AnimElemTime(5)<0
ProjID = 99995
projanim =1
projremovetime = 1
ignorehitpause = 1

[State 200, snd];voice
type = playsnd
trigger1 = PrevStateNo != 9000
trigger1 = animelem=1 && random<200
value = 3,random%2
channel = 0

[State 200, 1];snd
type = PlaySnd
trigger1 = animelem = 2
value = 0, 1
channel = 1

[State 200, 1]
type = HitDef
triggerall = Var(18) <= 15
trigger1 = !movecontact && !movereversed
attr = S, NA
damage = ceil(ifElse(fvar(11) * 29 < 7, 7, fvar(11) * 29)), 0
animtype = Medium
guardflag = MA
hitflag = MAF
pausetime = 10,11
guard.pausetime = 11,11
sparkno = s7020
guard.sparkno = s7000
sparkxy = -22,-70
hitsound = s5, 1
guardsound = S6,0
ground.type = High
ground.slidetime = 12
ground.hittime  = 12
ground.velocity = -2.5
guard.velocity = -6
airguard.velocity = -2,-1.1
air.type = High	
air.velocity = -3,-3
air.hittime = 12
air.animtype = back
getpower= Cond(Var(14),20,40),35
givepower = 35,35
yaccel = 0.5
ID = 200

[State 0, VarAdd]
type = VarAdd
trigger1 = MoveHit = 1
trigger1 = P2StateType = A || P2StateType = L
var(18) = 7
ignorehitpause = 1
persistent = 0

    [State 200, Time Offset]
    type = VarSet
    trigger1 = moveContact = 1
    var(15) = Time
    ignorehitpause = 1
    persistent = 0

    [State 200, Play Anim]
    type = ChangeAnim
    triggerall = AnimElemTime(3) >= 0 && AnimElemTime(4) <= 0 ;(2)would be the blur frame while (3) is the nonblur
    trigger1 = hitPauseTime = [1,6 - (1 - var(15))] ;[1,10 - (5 - var(15))] means [1,10 {change the 10 to the hitpausetime} - (5 {change the 5 to how long it takes before you get to the frame you want the pause to stay on}- var(15))]
    value = anim
    elem = 4
    ignorehitpause = 1

[State 0, AttackDist]
type = AttackDist
trigger1 = AnimElemTime(5)>=0
value = 0

[State 0, basics limiter]
type = Explod
triggerall = !IsHelper
trigger1 = !NumExplod(987654321)
trigger1 = movehit
trigger1 = numtarget
anim = 15999
ID = 987654321
pos = 0,0
postype = p1  ;p2,front,back,left,right
removetime = 24
removeongethit = 0
ignorehitpause = 1

[State 200, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

