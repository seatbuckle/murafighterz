;Armor Hit Loop
[Statedef 221]
type = A
physics = N
movetype = I
ctrl = 0

[State 0]
Type=LifeAdd
Trigger1=!Time
Value=-Floor(GetHitVar(Damage)*1)
Kill=1

[State 1541, NotHitBy]
type = NotHitBy
trigger1 = 1
time = 1
value = SCA

[State -2, PalFX] 
type =null;PalFX
Trigger1=!Time
time = 10
add = 164,0,0
mul = 266,256,256
sinadd = 164,0,0,30
invertall = 0
color = 256
ignorehitpause = 1

[State 1541, VarAdd] ;Number of hits remaining
type =null; VarAdd
trigger1 = !time
var(12) = -1
ignorehitpause = 1
persistent = 0

[State 2315, ChangeState]
type = ChangeState
trigger1 = !time
value = 220 ;go back
ctrl = 0
;---------------------------------------------------------------------------
; Hit by STRONG PUNCH 
[Statedef 222]
type = A
movetype = H
physics = N
ctrl = 0
velset=0,0

[State VelSet];Move backwards
Type=VelSet
Trigger1=Time=0
X=(GetHitVar(Xvel)*.3)*Facing

[State 0]
Type=VelSet
Trigger1=HitOver
Trigger2=Time>=GetHitVar(SlideTime)
X=0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1=Pos Y = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)
[State ChangeAnim];Recovery Anim Standing
Type=ChangeAnim
trigger1=Pos Y = 0&&!AnimTime
Value= 5005 + GetHitVar(AnimType)
;-------AIR
[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030
[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type
[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 0]
Type=ChangeAnim
trigger1 = Pos Y != 0
Trigger1=AnimExist(5035)
Trigger1=Anim=5030&&!Animtime
Value=5035
Elem=1

[State 0]
Type=ChangeAnim
trigger1 = Pos Y != 0
Trigger1=AnimExist(5050)
Trigger1=Anim=5035&&!Animtime
Trigger2=Pos Y=0
Trigger2=(Anim=5005 + GetHitVar(AnimType)) && Time = 40
Value=5050
Elem=1

[State VelSet];Move backwards
Type=VelSet
trigger1 = Pos Y != 0
Trigger1=Time=0
X=(GetHitVar(Xvel))*Facing
Y=(GetHitVar(Yvel));*Facing

[State 0];Gravity
Type=VelAdd
trigger1 = Pos Y != 0
Trigger2=Anim = 5050
Y=GetHitVar(Yaccel)

[State 0, Self State]
Type=SelfState
Trigger1=HitOver&&Time>1
Trigger1=Pos Y>=10
Value=5100
Ctrl=0

[State 0, ChangeState]
type = null;ChangeState
trigger1 = !AnimTime
value = 5050

