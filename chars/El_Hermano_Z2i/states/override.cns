;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
movetype = I
sprpriority = 0

;power up limiters
[State 0, VarSet]
type = VarSet
trigger1 = PrevStateNo = 210 && StateNo != 210
trigger2 = PrevStateNo = 240 && StateNo != 240
trigger3 = PrevStateNo = 410 && StateNo != 410
trigger4 = PrevStateNo = 440 && StateNo != 440
trigger5 = PrevStateNo = 610 && StateNo != 610
trigger6 = PrevStateNo = 640 && StateNo != 640
trigger7 = PrevStateNo = 205 && StateNo != 205
trigger8 = RoundState != 2
fvar(15) = 0

[State 0, ScreenBound]
type = ScreenBound
trigger1 = NumProjID(3111)
value = 0
movecamera = 0,0

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = NumProjID(3111)
flag = invisible
flag2 = noBG
flag3 = noFG

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = NumProjID(3111)
flag = nobardisplay

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

;---------------------------------------------------------------------------
; Stand2
[Statedef 3]
type = S
physics = S
movetype = I
sprpriority = 0

;power up limiters
[State 0, VarSet]
type = VarSet
trigger1 = PrevStateNo = 210 && StateNo != 210
trigger2 = PrevStateNo = 240 && StateNo != 240
trigger3 = PrevStateNo = 410 && StateNo != 410
trigger4 = PrevStateNo = 440 && StateNo != 440
trigger5 = PrevStateNo = 610 && StateNo != 610
trigger6 = PrevStateNo = 640 && StateNo != 640
trigger7 = PrevStateNo = 205 && StateNo != 205
trigger8 = RoundState != 2
fvar(15) = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 2 && Anim != 5 
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 2

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

[State 0, ChangeState]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1


;---------------------------------------------------------------------------
; Stand to Crouch
[StateDef 10]
type = C
physics = C
moveType = I
velSet = 0,0
sprPriority = 0

;power up limiters
[State 0, VarSet]
type = VarSet
trigger1 = PrevStateNo = 210 && StateNo != 210
trigger2 = PrevStateNo = 240 && StateNo != 240
trigger3 = PrevStateNo = 410 && StateNo != 410
trigger4 = PrevStateNo = 440 && StateNo != 440
trigger5 = PrevStateNo = 610 && StateNo != 610
trigger6 = PrevStateNo = 640 && StateNo != 640
trigger7 = PrevStateNo = 205 && StateNo != 205
trigger8 = RoundState != 2
fvar(15) = 0

[State 10, Reversed Commands: change to jumping]
type = ChangeState
trigger1 = !Time
trigger1 = enemy, NumExplod(92828282) || enemy, NumExplod(92468246) && command = "holddown"
value = 40

[State 10, ChangeAnim]
type = ChangeAnim
trigger1 = !Time && Anim = 12
value = 10
elem = 3 - AnimElemNo(0)

[State 10, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 10
value = 10

[State 10, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[State 10, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;Crouching
[StateDef 11]
type = C
physics = C
moveType = I
anim = 11
velSet = 0,0
sprPriority = 0

[State 11, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 6 && !AnimTime
value = 11

[State 0]
Type=null;Width
Trigger1=1
Value=20,20


;Crouch to Stand
[StateDef 12]
type = S
physics = S
moveType = I
velSet = 0,0
sprPriority = 0

;power up limiters
[State 0, VarSet]
type = VarSet
trigger1 = PrevStateNo = 210 && StateNo != 210
trigger2 = PrevStateNo = 240 && StateNo != 240
trigger3 = PrevStateNo = 410 && StateNo != 410
trigger4 = PrevStateNo = 440 && StateNo != 440
trigger5 = PrevStateNo = 610 && StateNo != 610
trigger6 = PrevStateNo = 640 && StateNo != 640
trigger7 = PrevStateNo = 205 && StateNo != 205
trigger8 = RoundState != 2
fvar(15) = 0

[State 12, Reversed Commands: change to "fake" crouch state]
type = ChangeState
trigger1 = !Time
trigger1 = enemy, NumExplod(92828282) || enemy, NumExplod(92468246) && command = "holdup"
value = 13

[State 12, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 12
value = 12

[State 12, End]
type = ChangeState
trigger1 = command = "holddown" && command != "holdup"
value = 10

[State 12, End]
type = ChangeState
trigger1 = !AnimTime
value = 0

;"Fake" crouch state (for reversed commands)
[StateDef 13]
type = C
physics = C
moveType = I
velSet = 0,0
sprPriority = 0
ctrl = 1

[State 13, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 10 && Anim != 11 
value = 10

[State 13, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 10 && !AnimTime
value = 11

;===========================================================================
;JUMP START OVERRIDE
;===========================================================================
;
[Statedef 40]
type    = S
physics = S
;anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

;power up limiters
[State 0, VarSet]
type = VarSet
trigger1 = PrevStateNo = 210 && StateNo != 210
trigger2 = PrevStateNo = 240 && StateNo != 240
trigger3 = PrevStateNo = 410 && StateNo != 410
trigger4 = PrevStateNo = 440 && StateNo != 440
trigger5 = PrevStateNo = 610 && StateNo != 610
trigger6 = PrevStateNo = 640 && StateNo != 640
trigger7 = PrevStateNo = 205 && StateNo != 205
trigger8 = RoundState != 2
fvar(15) = 0

[State 200, a]
type = ChangeAnim
triggerall = PrevStateNo != 9000
trigger1 = time = 0
value = 40

[State 40, Reversed Commands: change to "fake" crouch state]
type = ChangeState
trigger1 = !Time
trigger1 = enemy, NumExplod(92828282) || enemy, NumExplod(92468246) && command = "holdup"
value = 13

[State 0, VarRandom]
type = VarRandom
trigger1 = !AILEVEL>0
trigger1 = !Time
v = 37
range = 0,6

[State -1, Ground to Air]
type = ChangeState
value = cond(power>=2000,3000,1600)
triggerall = AILevel>4  
trigger1 =  NumTarget(1001)

[State -1, Super Jump Forward]
type = ChangeState
value = 10232
triggerall = AILevel>0 
triggerall = Var(37)=1
trigger1 = P2BodyDist X > 100 && random >500
trigger2 = (enemynear,movetype!=A || backedgebodydist<=10)

[State -1, Super Jump Backward]
type = ChangeState
value = 10233
triggerall = AILevel>0 
triggerall =  Var(37)=2
trigger1 = (P2BodyDist X =[1,60]) && random >500
trigger2 = (enemynear,movetype=A)

[State -1, Super Jump Straight Up]
type = ChangeState
value = 10231
triggerall = AILevel>0  
trigger1 =  Var(37)=3

[State 40, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA,AT
time = 1

[State 40, HitBy]
type = HitBy
trigger1 = 1
value = SCA,AA,AP
time = 1

[State 0, Explod]
type = Explod
trigger1 = !Time
anim = 15999
ID = 110
removetime = 8
removeongethit = 1

[State 100, jump SND]
type = playsnd
trigger1 = time = 0
value = 40,1
channel = 11

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, Direction]
type = VarSet
trigger1 = !AILevel
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
sysvar(1) = ifElse(!Time, 0, ifElse(command = "holdfwd", 1, ifElse(command = "holdback", -1, sysvar(1))))

[State 40, Direction (Reversed Commands)]
type = VarSet
trigger1 = !AILevel
trigger1 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
sysvar(1) = ifElse(!Time, 0, ifElse(command = "holdback", 1, ifElse(command = "holdfwd", -1, sysvar(1))))

[State 40, 2]
type = VarSet
triggerall = AILEVEL
trigger1 = P2BodyDist X > 80 && random >500
trigger2 = (enemynear,movetype!=A || backedgebodydist<=10)
sysvar(1) = 1

[State 40, 3]
type = VarSet
triggerall = AILEVEL
trigger1 = (P2BodyDist X =[1,60]) && random >500
trigger2 = (enemynear,movetype=A)
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)


[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = NumExplod(90011009) || NumExplod(90011207) || NumExplod(90011309) || NumExplod(90011407) || NumExplod(90011008) || NumExplod(90011408)
trigger1 = AnimElemTime(2)>=0
value = 40
elem = 1
persistent = 0

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;===========================================================================
;JUMP UP OVERRIDE (taking into account super jump commands)
;===========================================================================

; Jump Up
[Statedef 50]
type    = A
physics = A

;jump link infinite prevention on tall chars--see -2 for removeexplod
[State 0, Explod]
type = Explod
trigger1 = NumExplod(52)<4
trigger1 = P2StateType != A
trigger1 = Time = 0
anim = 15999
ID = 52
removetime = -1
removeongethit = 1

[State 0, VelSet]
type = VelSet
trigger1 = prevstateno = 1003
x = 0
;ignorehitpause = 
;persistent = 


[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
triggerall = PrevStateNo != 9000
trigger1 = time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[state veladd F]
type = veladd
triggerall = !AILEVEL
triggerall = (prevstateno = [10231,10233])
trigger1 = time > 8 && vel X< 4
trigger1 = (ifelse(Facing = 1, (NumExplod(90000009) || NumExplod(90000006) || NumExplod(90000003)),(NumExplod(90000007) || NumExplod(90000004) || NumExplod(90000001))))
x = 0.25

[state veladd]
type = veladd
triggerall = AILevel>0 && numenemy
triggerall = prevstateno = [10231,10233]
triggerall = time > 8 && vel X< 4
trigger1 = enemynear,Movetype!=A
x = Ifelse(enemynear,Movetype=H,0.5,0.25)

[state veladd R]
type = veladd
triggerall = !AILEVEL
triggerall = (prevstateno = [10231,10233])
trigger1 = time > 15 && vel X> -4
trigger1 = (ifelse(Facing = 1, (NumExplod(90000007) || NumExplod(90000004) || NumExplod(90000001)),(NumExplod(90000009) || NumExplod(90000006) || NumExplod(90000003))))
x = -0.1

[state veladd]
type = veladd
triggerall = AILevel>0
triggerall = prevstateno = [10231,10233]
trigger1 = time > 15 && vel X> -4
trigger1 = enemynear,Movetype=A
x = -0.1

[State 50, 3]
type = ChangeAnim
triggerall = PrevStateNo != 9000
triggerall = (prevstateno != [10231,10233]) && (anim != 44) && (anim != 42) && (anim != 45)
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
triggerall = PrevStateNo != 9000
triggerall = (prevstateno != [10231,10233]) && (anim = 42)
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = 45  ;ifelse(var(4)=1,45,44)


[State 50, 3]
type = ChangeAnim
triggerall = PrevStateNo != 9000
triggerall = prevstateno = [10231,10233]
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
;value = 44
value = Anim + 3

;===========================================================================
; WALK - Sounds added
;===========================================================================
[Statedef 20]
type    = S
physics = S
sprpriority = 0

;power up limiters
[State 0, VarSet]
type = VarSet
trigger1 = PrevStateNo = 210 && StateNo != 210
trigger2 = PrevStateNo = 240 && StateNo != 240
trigger3 = PrevStateNo = 410 && StateNo != 410
trigger4 = PrevStateNo = 440 && StateNo != 440
trigger5 = PrevStateNo = 610 && StateNo != 610
trigger6 = PrevStateNo = 640 && StateNo != 640
trigger7 = PrevStateNo = 205 && StateNo != 205
trigger8 = RoundState != 2
fvar(15) = 0

[State 0, Helper]
type = Helper
trigger1 = !NumHelper(20)
trigger1 = Anim = 20
trigger1 = enemy, Vel X >0
trigger1 = (P2MoveType = I)
trigger1 = P2BodyDist X <=10
name = "don't push me around"
ID = 20
stateno = 22
pos = 0,0
postype = p1    ;p2,front,back,left,right
facing = 1

[State 20, VelSet]
type = VelSet
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
trigger1 = command = "holdfwd"
trigger2 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
trigger2 = command = "holdback"
x = cond(var(50)=0,const(velocity.walk.fwd.x),2.6)



[State 20, VelSet]
type = VelSet
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
trigger1 = command = "holdback"
trigger2 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
trigger2 = command = "holdfwd"
x = cond(var(50)=0,const(velocity.walk.back.x),-2.4)
 
[State 0, VelSet eh]
type = VelSet
triggerall = Anim = 20
trigger1 = AnimElemTime(6)>=0 && AnimElemTime(6)<8
trigger2 = AnimElemTime(12)>=0 && AnimElemTime(12)<8
x = (const(velocity.walk.fwd.x))/4;0

[State 0, VelSet ah]
type = VelSet
triggerall = Anim = 20
trigger1 = AnimElemTime(7)>=0 && AnimElemTime(7)<6
trigger2 = AnimElemTime(1)>=0 && AnimElemTime(1)<6
x = (const(velocity.walk.fwd.x))/1.5 ;0



[State 0, VelSet]
type = VelSet
triggerall = Anim = 21
trigger1 = AnimElemTime(4)>=0 && AnimElemTime(4)<9
trigger2 = AnimElemTime(10)>=0 && AnimElemTime(10)<9
x = (const(velocity.walk.back.x))/1.2
[State 0, VelSet]
type = VelSet
triggerall = Anim = 21
trigger1 = AnimElemTime(5)>=0 && AnimElemTime(5)<9
trigger2 = AnimElemTime(11)>=0 && AnimElemTime(11)<9
x = (const(velocity.walk.back.x))/3.5
[State 0, VelSet]
type = VelSet
triggerall = Anim = 21
trigger1 = AnimElemTime(6)>=0 && AnimElemTime(6)<7
trigger2 = AnimElemTime(12)>=0 && AnimElemTime(12)<7
x = (const(velocity.walk.back.x))/1.5

[State 20, 3]
type = ChangeAnim
triggerall = PrevStateNo != 9000
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = PrevStateNo != 9000
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 0, Explod]
type = Explod
trigger1 = !enemy, NumExplod(94646464) && !enemy, NumExplod(92468246)
trigger1 = command = "holdback"
trigger2 = enemy, NumExplod(94646464) || enemy, NumExplod(92468246)
trigger2 = command = "holdfwd"
anim = 1
ID = 2
removetime = 2
removeongethit = 1

[State 100, steps]
type = playsnd
trigger1 = animelemtime(6)=0 && anim=20
trigger2 = animelemtime(12)=0 && anim=20
value = 0,50+Random%2
[State 100, steps]
type = playsnd
trigger1 = animelemtime(4)=0 && anim=21 
trigger2 = animelemtime(10)=0 && anim=21
value = 0,50+Random%2

[State 0]
Type=null ;EnvShake
trigger1 = animelemtime(6)=0 && anim=20
trigger2 = animelemtime(12)=0 && anim=20
trigger3 = animelemtime(4)=0 && anim=21 
trigger4 = animelemtime(10)=0 && anim=21
Time=3
Freq=70
Ampl=1

[State 20, 1]
type = VelSet
trigger1 = AILevel
x = const(velocity.walk.fwd.x)

