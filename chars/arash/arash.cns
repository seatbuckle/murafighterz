[Statedef -3]

[State 詠唱用var0]
type = Null
trigger1 = var(0) := 0	;0で完全詠唱　1で省略
IgnoreHitPause = 1

[State ライフ回復用var50var51]
type = Null
trigger1 = var(50) := 1000
trigger1 = var(51) := 10
IgnoreHitPause = 1
;var(51)フレーム内に合計var(50)以上のダメージでライフ回復

