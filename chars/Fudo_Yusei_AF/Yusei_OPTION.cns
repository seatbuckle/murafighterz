[Statedef -2]
;-----------------------------------------------------------------------------------------------------------
;　基本オプション
;-----------------------------------------------------------------------------------------------------------

[State -2, リジェネレーション値]
Type = VarSet
Trigger1 = 1
V = 2
Value = 1   ;ここの値を変更。デフォルトは"1"。

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, 開幕ゲージMAXスイッチ]
Type = VarSet
Trigger1 = !IsHelper
V = 3
Value = 0  ;ここを変更。デフォルトは"OFF"。 0:OFF 1:ON

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, 落下ダメージ耐性スイッチ]
Type = VarSet
Trigger1 = !IsHelper
V = 4
Value = 1  ;ここを変更。デフォルトは"ON"。 0:OFF 1:ON

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, ライフ管理弱体化スイッチ]
Type = VarSet
Trigger1 = !IsHelper
V = 5
Value = 0  ;ここを変更。デフォルトは"OFF"。 0:OFF 1:ON

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, ラストターン解禁ライフ条件]
Type = VarSet
Trigger1 = 1
V = 6
Value = 1200 ;ここの値を変更。デフォルトは"1200(体力MAX状態)"。

IgnoreHitPause = 1
;-------------------------------------------------------------------------------------------------------
;　カラー別設定用オプション
;-------------------------------------------------------------------------------------------------------

[State -2, パワーゲージ自動上昇量]
Type = Null
TriggerAll = !IsHelper
;--------------------------[1P]
Trigger1 = PalNo = 1
Trigger1 = Var(1) := 1    ;ここを変更。デフォルトは"1"

;--------------------------[2P]
Trigger2 = PalNo = 2
Trigger2 = Var(1) := 1     ;ここを変更。デフォルトは"1"

;--------------------------[3P]
Trigger3 = PalNo = 3
Trigger3 = Var(1) := 5     ;ここを変更。デフォルトは"5"

;--------------------------[4P]
Trigger4 = PalNo = 4
Trigger4 = Var(1) := 7     ;ここを変更。デフォルトは"5"

;--------------------------[5P]
Trigger5 = PalNo = 5
Trigger5 = Var(1) := 10    ;ここを変更。デフォルトは"10"

;--------------------------[6P]
Trigger6 = PalNo = 6
Trigger6 = Var(1) := 10    ;ここを変更。デフォルトは"10"

;--------------------------[7P]
Trigger7 = PalNo = 7
Trigger7 = Var(1) := 5     ;ここを変更。デフォルトは"5"

;--------------------------[8P]
Trigger8 = PalNo = 8
Trigger8 = Var(1) := 10    ;ここを変更。デフォルトは"10"

;--------------------------[9P]
Trigger9 = PalNo = 9
Trigger9 = Var(1) := 10    ;ここを変更。デフォルトは"10"

;--------------------------[10P]
Trigger10 = PalNo = 10
Trigger10 = Var(1) := 10   ;ここを変更。デフォルトは"10"

;--------------------------[11P]
Trigger11 = PalNo = 11
Trigger11 = Var(1) := 10   ;ここを変更。デフォルトは"10"

;--------------------------[12P]
Trigger12 = PalNo = 12
Trigger12 = Var(1) := 10   ;ここを変更。デフォルトは"10"

IgnoreHitPause = 1

;---------------------------------------------------------------------------------------
;　カスタムカラー(6P)用オプション
;---------------------------------------------------------------------------------------

[State -2, 攻撃力補正]
Type = VarSet
Trigger1 = !IsHelper
Trigger1 = PalNo = 6
FV = 10
Value = 1.0  ;ここを変更。デフォルトは"1.0"。

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, 防御力補正]
Type = VarSet
Trigger1 = !IsHelper
Trigger1 = PalNo = 6
FV = 11
Value = 1.0  ;ここを変更。デフォルトは"1.0"。

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, 無敵量設定]
Type = VarSet
Trigger1 = !IsHelper
Trigger1 = PalNo = 6
V = 30
Value = 1  ;ここを変更。デフォルトは"1"。

;"0" … 無敵なし
;"1" … 攻撃中無敵
;"2" … 攻撃中無敵+喰らい中無敵
;"3" … Anim=0以外無敵

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, ライフ管理スイッチ]
Type = VarSet
Trigger1 = !IsHelper
Trigger1 = PalNo = 6
V = 31
Value = 1  ;ここを変更。デフォルトは"ON"。 0:OFF 1:ON

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, ダメージフィルター上限値]
Type = VarSet
Trigger1 = !IsHelper
Trigger1 = PalNo = 6
V = 32
Value = 500  ;ここを変更。デフォルトは"500"。

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, ダメージフィルター下限値]
Type = VarSet
Trigger1 = !IsHelper
Trigger1 = PalNo = 6
V = 33
Value = 50   ;ここを変更。デフォルトは"50"。

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, 常時GameTime式ステ抜けスイッチ]
Type = VarSet
Trigger1 = !IsHelper
Trigger1 = PalNo = 6
V = 34
Value = 1  ;ここを変更。デフォルトは"ON"。 0:OFF 1:ON

IgnoreHitPause = 1
;---------------------------------------------------------------

[State -2, 超必殺技強化Lv設定]
Type = VarSet
Trigger1 = !IsHelper
Trigger1 = PalNo = 6
V = 35
Value = 0  ;ここを変更。デフォルトは"0"。

;"0" … 基本性能

;"1" … 物理的ダイレクトアタック：50～150ダメージ×攻撃力補正値
     　 牛乳激流葬：100～500ダメージ×攻撃力補正値
     　 ラストターン・スクラップフィスト：500～10000000ダメージ×攻撃力補正値

;"2" … 物理的ダイレクトアタック：50～150ダメージ×攻撃力補正値 + 落下即死
     　 牛乳激流葬：100～1000ダメージ×攻撃力補正値 + 永続タゲTargetLifeAdd削り
     　 ラストターン・スクラップフィスト：オーバーフロー即死 + 永続タゲTargetLifeAdd即死

IgnoreHitPause = 1
;---------------------------------------------------------------------------------------
;　カスタムカラー(7P)用オプション
