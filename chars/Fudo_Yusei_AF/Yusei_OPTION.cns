TriggerAll = PalNo >= 7
TriggerAll = !IsHelper
TriggerAll = !NumHelper(9000)
Trigger1 = 1
Name = "Hyper_Armor"
ID = 9000
StateNo = 9000
Helpertype = Player
Size.XScale = 1
Size.YScale = 1
Pos = 0,0
OwnPal = 1
SuperMoveTime = 99999
PauseMoveTime = 99999

