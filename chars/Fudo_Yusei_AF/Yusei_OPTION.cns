[State -2, AssertSpecial];大ダメージ無効
Type = AssertSpecial
TriggerAll = Var(5) = 0
TriggerAll = PalNo = 4 || PalNo = 5 || (PalNo = 6 && Var(31) = 1)
TriggerAll = GetHitVar(Damage) > Var(32)
Trigger1 = 1
Flag = NoKO
IgnoreHitPause = 1

[State -2, AssertSpecial];大ダメージ無効
Type = AssertSpecial
TriggerAll = Var(5) = 0
TriggerAll = PalNo >= 7
TriggerAll = Helper(9000),GetHitVar(Damage) > Var(32)
Trigger1 = 1
Flag = NoKO
IgnoreHitPause = 1

[State -2, VarSet];ダメージ条件(アーマー無し)
Type = VarAdd
TriggerAll = PalNo = 4 || PalNo = 5 || (PalNo = 6 && Var(31) = 1)
TriggerAll = !IsHelper
TriggerAll = GetHitVar(Damage) = [(Var(33)),(Var(32))]
Trigger1 = StateNo != [120,155]
sysvar(3) = Floor(GetHitVar(Damage) * FVar(11))
IgnoreHitPause = 1

[State -2, VarSet];ダメージ条件(アーマー有り)
Type = VarAdd
TriggerAll = PalNo >= 7
TriggerAll = !IsHelper
TriggerAll = Helper(9000),GetHitVar(Damage) = [(Var(33)),(Var(32))]
Trigger1 = StateNo != [120,155]
sysvar(3) = Floor(Helper(9000),GetHitVar(Damage) * FVar(11))
IgnoreHitPause = 1

[State -2];ライフをセットします
Type = LifeSet
TriggerAll = PalNo >= 7 || PalNo = 4 || PalNo = 5 || (PalNo = 6 && Var(31) = 1)
TriggerAll = !IsHelper
Trigger1 = 1
Value = LifeMax - SysVar(3)
IgnoreHitPause = 1

[State -2, ライフ管理]
Type = LifeSet
TriggerAll = PalNo >= 7 || PalNo = 4 || PalNo = 5 || (PalNo = 6 && Var(31) = 1)
TriggerAll = !Alive
Trigger1 = !IsHelper
