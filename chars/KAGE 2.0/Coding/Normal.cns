; Standing Light Punch
; CNS difficulty: easy
[Statedef 200]
type    = S
poweradd = 12
movetype= A
physics = S
velset = 0,0
ctrl = 0
anim=200
poweradd= 25 * !var(20)
juggle = 2
sprpriority = 2
facep2 = 1

[State 200, Voice]
type = PlaySnd
trigger1 = AnimElem = 2
value = 0,0
channel = 0

[State 200, Swing Snd]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1,0
channel = 1

[State 200, Hit]
type = HitDef
;trigger1 = !var(16) && var(15) < 1
trigger1=animelem=2
attr = S, NA
damage = ceil(ifElse(fvar(11) * 25 < 7, 7, fvar(11) * 25)), 0
guardflag = M
hitflag = MAF

getpower = 50 * !var(20), 30 * !var(20)
givepower = 30, 30
priority = 4, Hit
pausetime = 8, 8
guard.pausetime = 8, 8
sparkNo = -1 + 0 * (var(33) := 8010)
guard.sparkNo = -1 + 0 * (var(34) := 8000)
sparkXY = -10 + 0 * (var(35) := 80), var(36):=-85
hitsound = S2, 0
guardsound = s130, 0
animType = Light
air.animType = Back
fall.animType = Back
ground.type = High
air.type = Low
ground.slidetime = 6 + 2 * var(9)
ground.hittime  = 18 + 2 * var(9)
guard.hittime = 12
ground.velocity = -2.5
guard.velocity = -5.5
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
air.velocity = -1.5,-3
air.hittime = 120
fall = 0
fall.recover = 1
fall.recoverTime = 120

[State 0, ChangeState]
type = ChangeState
trigger1 = movecontact
trigger1 = command = "qcba"||command = "qcbb"||command = "qcbc"
value = 1200
ctrl = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = movecontact&&command="Shakunetsuhadouken"
value = 1050
ctrl = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = movecontact&&command="Gouhadouken" 
value = 1000
ctrl = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = movecontact
trigger1 = command = "b+y"
value = 1300
ctrl = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = movecontact
trigger1 = command = "holddown" &&  command = "c+z"
value = 1500
ctrl = 1

[State 200, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

