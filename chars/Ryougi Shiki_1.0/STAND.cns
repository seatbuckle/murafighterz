
;=============================================================================
; Statedef -2開始
;=============================================================================
[Statedef -2]

; ============================================================
; ユーザ設定ファイルです。(注：★の箇所は書き換えないで下さい)
; ============================================================
; ここでは、特殊ゲージであるMCゲージ / ガードゲージ / ヴァイタルゲージ
; の3つのゲージ位置を変更することができます。
; 画面上におけるX軸とY軸の数値を入力して下さい。
; 尚、ガードゲージとヴァイタルゲージは連動して動きます。
;
;
; 〓〓〓〓〓〓〓〓
; 書き換え方法
; 〓〓〓〓〓〓〓〓
; 以下にMCゲージとガードゲージのXY軸の数値を入力する箇所が
; あります。mugenの画面上における、このX軸とY軸の数値を変える
; ことによってそれぞれのゲージの位置を変更します。
;
; 尚、mugenの画面はY軸では上方向がマイナス、X軸では右方向が
; プラスとなります。
; ┏━━━━━━━━━━━━┓
; ┃                        ┃↑
; ┃                        ┃Y
; ┃                        ┃軸
; ┃       mugen画面        ┃マ
; ┃                        ┃イ
; ┃                        ┃ナ
; ┃                        ┃ス
; ┃                        ┃側
; ┃                        ┃
; ┗━━━━━━━━━━━━┛
;        X軸プラス側→
;
;
; 【例１】MCゲージを23ドット右に動かす場合
;
; ①.MCゲージのX軸の数値を決めている箇所を探す(この場合は以下になる)
; [State 5900, MCゲージ座標　X軸]　←どの座標かはここで確認できるお
; type = VarSet
; trigger1 = 1
; var(52) = 0		←デフォルトでは0になっている
; persistent = 0
;
; ②."var(52) = 0" という箇所の最後の数値(デフォルトでは0)を変える。
; ここの例では23ドットゲージ位置を右に動かすため、"23"と入力する(左に動かす場合は-23)。
;
; [State 5900, MCゲージ座標　X軸]
; type = VarSet
; trigger1 = 1
; var(52) = 23		←変えた
; persistent = 0
;
; ※"var(52) = 0" の最後の数値以外は変更する必要なし
;
;------------------------------------------------------------
; 【例２】ガードゲージを100ドット上に動かす場合
;
; ①.ガードゲージのY軸の数値を決めている箇所を探す(この場合は以下になる)
;[State 5900, ガードゲージ座標　Y軸]
;type = VarSet
;trigger1 = 1
;var(55) = 0		←デフォルトでは0になっている
;persistent = 0
;
; ②."var(55) = 0" という箇所の最後の数値(デフォルトでは0)を変える。
; ここの例では100ドットゲージ位置を上に動かすため、"-100"と入力する(下に動かす場合は100)。
;
;[State 5900, ガードゲージ座標　Y軸]
;type = VarSet
;trigger1 = 1
;var(55) = -100		←変えた
;persistent = 0
;
; ※"var(55) = 0" の最後の数値以外は変更する必要なし
;
;
; 【テンプレ】
;
; jojoのスタンドゲージと同じ位置にガードゲージを表示
; --------------------------------------------------
; ガードゲージX軸の値：-65
; ガードゲージY軸の値：-180
;
;
;
; 上記の要領で、下記を変更して下さい。
;

[State 5900, MCゲージ座標　X軸（デフォルト:0）]
type = VarSet
trigger1 = 1
var(52) = 0
persistent = 0

[State 5900, MCゲージ座標　Y軸（デフォルト:0）]
type = VarSet
trigger1 = 1
var(53) = 0
persistent = 0

[State 5900, ガードゲージ/ヴァイタルゲージ座標　X軸（デフォルト:0）]
type = VarSet
trigger1 = 1
var(54) = 0
persistent = 0

[State 5900, ガードゲージ/ヴァイタルゲージ座標　Y軸（デフォルト:-180）]
type = VarSet
trigger1 = 1
var(55) = -180
persistent = 0
; ============================================================
; ユーザ設定　ここまで（ここ以降は書き換え禁止）
; ============================================================

[State -2, ゲージ類消去フラグOFF]
type = VarSet
trigger1 = 1
fvar(9) = 0
ignorehitpause = 1

[State -2, ゲージ類消去フラグON]
type = VarSet
;▼ラウンド開始前
trigger1 = roundstate = [0,1]
;▼LA中
trigger2 = stateno = [4800,4801]
fvar(9) = 1
ignorehitpause = 1

[State -2, ゲージ類消去フラグON - 相手と同期]
type = VarSet
;▼相手 - 式
trigger1 = enemy,name = "Ryougi Shiki"
trigger1 = enemy,authorname = "41"
trigger1 = ceil(enemy,fvar(9)) = 1
;▼相手 - 姫
trigger2 = enemy,name = "ARCHETYPE:EARTH"
trigger2 = enemy,authorname = "41"
trigger2 = ceil(enemy,fvar(9)) = 1
fvar(9) = 2
ignorehitpause = 1

[State -2, ゲージ類消去フラグON]
type = VarSet
;ナイフとか設置かぜとかだけ消したいならここに条件追加
;但し、superpause中はなぜか相手のvar参照が更新されず無視される。。。
trigger1 = stateno = 4701
trigger2 = stateno = 4751
fvar(9) = 3
ignorehitpause = 1

[State -2, ゲージ類消去フラグON - 相手と同期]
type = VarSet
;▼相手 - 式
trigger1 = enemy,name = "Ryougi Shiki"
trigger1 = enemy,authorname = "41"
trigger1 = ceil(enemy,fvar(9)) = 3
;▼相手 - 姫
trigger2 = enemy,name = "ARCHETYPE:EARTH"
trigger2 = enemy,authorname = "41"
trigger2 = ceil(enemy,fvar(9)) = 3
fvar(9) = 4
ignorehitpause = 1

[State -2, ゲージ類消去フラグ - ライフバー消去]
type = AssertSpecial
trigger1 = fvar(9) = [1,2]
flag = nobardisplay
ignorehitpause = 1

;=============================================================================
;  HEAT / BLOOD HEATオーラ
;=============================================================================
[State -2, HEAT / BLOOD HEATオーラヘルパー]
type = Helper
trigger1 = !NumHelper(40000)
trigger1 = var(6) = [1,3]	;MAX / HEAT / B-HEAT
id = 40000
stateno = 40000
pos = 0,0
postype = p1
ownpal = 1
pausemovetime = 999999999
supermovetime = 999999999
ignorehitpause = 1

;=============================================================================
; コーナープッシュ処理（12/10/7 試験導入）
;
; どぶろく氏（Tene氏）の聖典シエル（Powerd_Ciel-2-3.cns）より記述を拝借致しました。
; 現在読解中・・・。難い・・・
; ※実装時は(基本的に)全てのHitdefのguard.cornerpush.veloffに0を設定する
; 自己メモ：ダウン追い打ちor空中ヒット時のノックバックが異常、原因不明
;=============================================================================
;〓〓〓〓〓〓〓〓〓
; 共通処理
;〓〓〓〓〓〓〓〓〓
[State -3, 画面端判定ヘルパー起動（正確には測位ヘルパー）]
type = null;Helper
triggerall = !IsHelper
triggerall = !NumHelper(112)
trigger1 = !NumPartner		;シングル
trigger2 = NumPartner		;タッグ
trigger2 = ID < Partner,ID
stateno = 112
id = 112
pos = 0,0
postype = p1
pausemovetime = 9999999999
supermovetime = 9999999999
ignorehitpause = 1

;〓〓〓〓〓〓〓〓〓
; シングル時処理
;〓〓〓〓〓〓〓〓〓
[State -3, 相手が地上食らい完了(shakeover)時のクリア（シングル時だと思う）]
type = VarSet
triggerall = !IsHelper
trigger1 = NumTarget = 1
trigger1 = !Target,GetHitVar(guarded)||Target,StateType != A
trigger1 = Target,MoveType = H && !Target,Ctrl
trigger1 = Target,HitShakeOver||Target,GetHitVar(guarded) && Target,StateNo != 150 && Target,StateNo != 152 && Target,StateNo != 154
trigger1 = Target,vel x && Target,StateType != A && Target,StateType != L||!Target,vel x && var(29) != Target,GetHitVar(hittime) && Target,StateNo != 5100 && Target,StateNo != 5110
var(29) = 0
ignorehitpause = 1

[State -3, クリア後(shakeover)、相手側食らい時間(hittime)を取得（シングル時だと思う）]
type = VarSet
triggerall = !IsHelper
trigger1 = NumTarget = 1
trigger1 = !var(29)
var(29) = Target,GetHitVar(hittime)
ignorehitpause = 1
persistent = 0

[State -3, 相手が空中ガードシェイク中は"1"を格納（シングル時だと思う）]
type = VarSet
triggerall = !IsHelper
trigger1 = NumTarget = 1
trigger1 = Target,MoveType = H && !Target,Ctrl
trigger1 = !Target,HitShakeOver && Target,GetHitVar(guarded) && Target,StateType = A
var(29) = 1
ignorehitpause = 1

[State -3, シェイク後は1を加算しまくる（シングル時だと思う）]
type = VarAdd
triggerall = !IsHelper
trigger1 = NumTarget = 1
trigger1 = Target,MoveType = H && !Target,Ctrl
trigger1 = Target,HitShakeOver && Target,GetHitVar(guarded) && Target,StateType = A
var(29) = 1
ignorehitpause = 1

[State -3, ★地上ヒット時のコーナープッシュ実施（シングル時だと思う）]
type = null;PosAdd
triggerall = !IsHelper
trigger1 = NumTarget = 1
trigger1 = Target,GetHitVar(fall.kill)
trigger1 = Stateno < 1000
trigger1 = Stateno != [559,565]	;J6B
trigger1 = !Ctrl
trigger1 = Target,Statetype = S && !Target,GetHitVar(guarded)||Target,Statetype = C && !Target,GetHitVar(guarded)||Target,GetHitVar(guarded) && Target,StateType != L && Target,StateNo = [120,155]
trigger1 = Target,MoveType = H && !Target,Ctrl && !Target,GetHitVar(isbound)
trigger1 = Target,HitShakeOver||Target,GetHitVar(guarded) && Target,StateNo != 150 && Target,StateNo != 152 && Target,StateNo != 154
trigger1 = Target,StateType != A||Target,GetHitVar(guarded) && Target,StateType = A && var(29) = [2,9]
trigger1 = (Target,vel x*ifelse(Target,p2dist X<0,-1,1)-Target,GetHitVar(xvel)*!Target,vel x*(var(29)>0))*ifelse(Target,StateType=S,Target,Const(movement.stand.friction),ifelse(Target,StateType=C,Target,Const(movement.crouch.friction),1)) < -fvar(12)
trigger1 = Target,BackEdgeDist = floor(fvar(12))||Target,FrontEdgeDist = floor(fvar(12))
x = (Target,vel x*ifelse(Target,p2dist X<0,-1,1)-Target,GetHitVar(xvel)*!Target,vel x*(var(29)>0))*ifelse(Target,StateType=S,Target,Const(movement.stand.friction),ifelse(Target,StateType=C,Target,Const(movement.crouch.friction),1))+fvar(12)
ignorehitpause = 1

[State -3, ★空中ヒット時のコーナープッシュ実施（シングル時だと思う）]
type = null;PosAdd
triggerall = !IsHelper
trigger1 = NumTarget = 1
trigger1 = Stateno < 1000
trigger1 = Stateno != [559,565]	;J6B
trigger1 = !Ctrl
trigger1 = Target,GetHitVar(fall.kill)
trigger1 = Target,Statetype != S && Target,Statetype != C && !Target,GetHitVar(guarded) && Target,GetHitVar(xvel)
trigger1 = Target,MoveType = H && !Target,Ctrl && !Target,GetHitVar(isbound)
trigger1 = Target,HitShakeOver||Target,GetHitVar(guarded) && Target,StateNo != 150 && Target,StateNo != 152 && Target,StateNo != 154
trigger1 = Target,BackEdgeDist = floor(fvar(12))||Target,FrontEdgeDist = floor(fvar(12))
;x = 4.0625*ifelse(Target,vel x>0,1,-1)*ifelse(Target,p2dist X<0,-1,1)*(var(29)>0)+fvar(12)
x = (Target,vel x*ifelse(Target,p2dist X<0,-1,1)-Target,GetHitVar(xvel)*!Target,vel x*(var(29)>0))*ifelse(StateType=S,Target,Const(movement.stand.friction),ifelse(StateType=C,Target,Const(movement.crouch.friction),1))+fvar(12)
ignorehitpause = 1


;〓〓〓〓〓〓〓〓〓
; タッグ時処理
;〓〓〓〓〓〓〓〓〓
[State -3, 相手が地上食らい完了(shakeover)時のクリア（タッグ時だと思う）]
type = VarSet
triggerall = !IsHelper
trigger1 = NumTarget != 1 && NumTarget > 0
trigger1 = P2MoveType = H && !enemynear(!enemynear,alive*enemy,alive),Ctrl
trigger1 = enemynear(!enemynear,alive*enemy,alive),HitShakeOver||enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded) && P2StateNo != 150 && P2StateNo != 152 && P2StateNo != 154
trigger1 = enemynear(!enemynear,alive*enemy,alive),vel x && P2StateType != A && P2StateType != L||!enemynear(!enemynear,alive*enemy,alive),vel x && var(29) != enemynear(!enemynear,alive*enemy,alive),GetHitVar(hittime) && P2StateNo != 5100 && P2StateNo != 5110
var(29) = 0
ignorehitpause = 1

[State -3, 相手が地上食らい完了(shakeover)時の食らい時間(hittime)を取得（タッグ時だと思う）]
type = VarSet
triggerall = !IsHelper
trigger1 = NumTarget != 1 && NumTarget > 0
trigger1 = !var(29)
var(29) = enemynear(!enemynear,alive*enemy,alive),GetHitVar(hittime)
ignorehitpause = 1
persistent = 0

[State -3, 相手が空中ガードシェイク時に"1"を格納（タッグ時だと思う）]
type = VarSet
triggerall = !IsHelper
trigger1 = NumTarget != 1 && NumTarget > 0
trigger1 = P2MoveType = H && !enemynear(!enemynear,alive*enemy,alive),Ctrl
trigger1 = !enemynear(!enemynear,alive*enemy,alive),HitShakeOver && enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded) && P2StateType = A
var(29) = 1
ignorehitpause = 1

[State -3, シェイク後は1を加算しまくる（タッグ時だと思う）]
type = VarAdd
triggerall = !IsHelper
trigger1 = NumTarget != 1 && NumTarget > 0
trigger1 = P2MoveType = H && !enemynear(!enemynear,alive*enemy,alive),Ctrl
trigger1 = enemynear(!enemynear,alive*enemy,alive),HitShakeOver && enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded) && P2StateType = A
var(29) = 1
ignorehitpause = 1

[State -3, ★地上ヒット時のコーナープッシュ実施（タッグ時だと思う）]
type = null;PosAdd
triggerall = !IsHelper
trigger1 = NumTarget != 1 && NumTarget > 0
trigger1 = Stateno < 1000
trigger1 = Stateno != [559,565]	;J6B
trigger1 = !Ctrl
trigger1 = enemynear(!enemynear,alive*enemy,alive),GetHitVar(fall.kill)
trigger1 = P2StateType = S && !enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded)||P2StateType = C && !enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded)||enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded) && P2StateType != L && P2StateNo = [120,155]
trigger1 = P2MoveType = H && !enemynear(!enemynear,alive*enemy,alive),Ctrl && !enemynear(!enemynear,alive*enemy,alive),GetHitVar(isbound)
trigger1 = enemynear(!enemynear,alive*enemy,alive),HitShakeOver||enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded) && P2StateNo != 150 && P2StateNo != 152 && P2StateNo != 154
trigger1 = P2StateType != A||enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded) && P2StateType = A && var(29) = [2,9]
trigger1 = (enemynear(!enemynear,alive*enemy,alive),vel x*ifelse(enemynear(!enemynear,alive*enemy,alive),p2dist X<0,-1,1)-enemynear(!enemynear,alive*enemy,alive),GetHitVar(xvel)*!enemynear(!enemynear,alive*enemy,alive),vel x*(var(29)>0))*ifelse(P2StateType=S,enemynear(!enemynear,alive*enemy,alive),Const(movement.stand.friction),ifelse(P2StateType=C,enemynear(!enemynear,alive*enemy,alive),Const(movement.crouch.friction),1)) < -fvar(12)
trigger1 = enemynear(!enemynear,alive*enemy,alive),BackEdgeDist = floor(fvar(12))||enemynear(!enemynear,alive*enemy,alive),FrontEdgeDist = floor(fvar(12))
x = (enemynear(!enemynear,alive*enemy,alive),vel x*ifelse(enemynear(!enemynear,alive*enemy,alive),p2dist X<0,-1,1)-enemynear(!enemynear,alive*enemy,alive),GetHitVar(xvel)*!enemynear(!enemynear,alive*enemy,alive),vel x*(var(29)>0))*ifelse(P2StateType=S,enemynear(!enemynear,alive*enemy,alive),Const(movement.stand.friction),ifelse(P2StateType=C,enemynear(!enemynear,alive*enemy,alive),Const(movement.crouch.friction),1))+fvar(12)
ignorehitpause = 1

[State -3, ★空中ヒット時のコーナープッシュ実施（タッグ時だと思う）]
type = null;PosAdd
triggerall = !IsHelper
trigger1 = NumTarget != 1 && NumTarget > 0
trigger1 = Stateno < 1000
trigger1 = Stateno != [559,565]	;J6B
trigger1 = !Ctrl
trigger1 = StateNo != 1120 && (StateNo!=1150||StateNo=1150&&AnimElemTime(3)>=0) && (StateNo!=1520||StateNo=1520&&AnimElemNo(0)!=[2,3]) && (StateNo!=1550||StateNo=1550&&AnimElemNo(0)!=[2,3]) && (StateNo!=3000||StateNo=3000&&AnimElemNo(0)!=[2,3])
trigger1 = enemynear(!enemynear,alive*enemy,alive),GetHitVar(fall.kill)
trigger1 = P2StateType != S && P2StateType != C && !enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded) && enemynear(!enemynear,alive*enemy,alive),GetHitVar(xvel)
trigger1 = P2MoveType = H && !enemynear(!enemynear,alive*enemy,alive),Ctrl && !enemynear(!enemynear,alive*enemy,alive),GetHitVar(isbound)
trigger1 = enemynear(!enemynear,alive*enemy,alive),HitShakeOver||enemynear(!enemynear,alive*enemy,alive),GetHitVar(guarded) && P2StateNo != 150 && P2StateNo != 152 && P2StateNo != 154
trigger1 = 3.0625*ifelse(enemynear(!enemynear,alive*enemy,alive),vel x>0,1,-1)*ifelse(enemynear(!enemynear,alive*enemy,alive),p2dist X<0,-1,1) < -fvar(12)
trigger1 = enemynear(!enemynear,alive*enemy,alive),BackEdgeDist = floor(fvar(12))||enemynear(!enemynear,alive*enemy,alive),FrontEdgeDist = floor(fvar(12))
x = 3.0625*ifelse(enemynear(!enemynear,alive*enemy,alive),vel x>0,1,-1)*ifelse(enemynear(!enemynear,alive*enemy,alive),p2dist X<0,-1,1)+fvar(12)
ignorehitpause = 1


;=============================================================================
; デバッグ表示
;=============================================================================
[State -2, 汎用]
type = DisplayToClipBoard
trigger1 = 1
text ="		var(35)= %d	p2facing = %d"
params =	var(35),		enemy,facing
supermovetime = 9999999
pausemovetime = 9999999
ignorehitpause = 1

[State -2, LAの桜背景消去（フェール処理）]
type = RemoveExplod
triggerall = NumExplod(12049)
trigger1 = stateno != [4800,4802]
trigger2 = movetype = H
trigger3 = statetype = L
id = 12049
ignorehitpause = 1

;=============================================================================
; 玻璃の月舎迦（EX）無敵時間スタック減算処理
;=============================================================================
[State -2, 無敵時間減算]
type = VarAdd
trigger1 = var(37)
var(37) = -1
ignorehitpause = 1

;=============================================================================
; 投げボイス決定フラグ（★段階BE判定/Fの波動3段2段目飛ばしでも流用）クリア
; Fの2段目飛ばし下段蹴り時はクリアしない
;
;=============================================================================
[State -2, クリア]
type = VarSet
triggerall = stateno != 801	;地上投げでクリアしたらボイスならない
triggerall = movetype != A
trigger1 = var(2)
trigger1 = ctrl
trigger1 = enemynear,ctrl
trigger2 = p2statetype = S || p2statetype = C
trigger2 = p2movetype = H
var(2) = 0
ignorehitpause = 1

;=============================================================================
; 石頭判定（LAセリフ振り分けフラグ流用　HはLAがないため）
;=============================================================================
[State -2, 石頭な石頭判定クリア]
type = VarSet
triggerall = var(9)
trigger1 = p2stateno = 1253		;清姫ヒット時にクリアする
trigger2 = movetype = H			;フェール
trigger3 = roundstate = 2
trigger3 = ctrl
var(9) = 0
ignorehitpause = 1

[State -2, 石頭な石頭判定]
type = VarSet
triggerall = !var(9)
triggerall = winko
trigger1 = stateno = 532 && movehit	;Hの4C
trigger2 = stateno = 540 && movehit	;Fの4C
var(9) = 1
ignorehitpause = 1

;=============================================================================
; シールドエフェ残留対応
;=============================================================================
[State -2, サークルエフェ消去] 
type = RemoveExplod 
trigger1 = NumExplod(12000) 
trigger1 = stateno != [900,929] 
id = 12000 
ignorehitpause = 1

[State -2, サークルエフェ2消去] 
type = RemoveExplod 
trigger1 = NumExplod(12010) 
trigger1 = stateno != [900,960]
id = 12010
ignorehitpause = 1

;=============================================================================
; AD/AAD/LA - KO演出
;=============================================================================
[State -2, KO演出]
type = Helper
triggerall = !NumHelper(14000) && RoundState = 3 && WinKO
trigger1 = stateno%10000 = [4700,4705]
trigger2 = stateno%10000 = [4750,4755]
trigger3 = var(11)
trigger3 = stateno != 520	;これがないとC6CでKOした場合もLAKOが出る
stateno = 14000
ID = 14000
pos = 0,0
postype = p1
ownpal = 1
supermovetime = 99999
pausemovetime = 99999
ignorehitpause = 1
persistent = 0

[State -2, パーフェクト演出]
type = Helper
triggerall = !IsHelper
trigger1 = !NumHelper(14000)
trigger1 = !NumHelper(14005) && RoundState = 4 && WinPerfect
stateno = 14005
ID = 14005
pos = 0,0
postype = p1
ownpal = 1
supermovetime = 99999
pausemovetime = 99999
ignorehitpause = 1
persistent = 0

;=============================================================================
; 重力補正
;=============================================================================
[State -2, 重力補正]
type = VarSet
trigger1 = 1
fvar(13) = 1.0000 - (Enemy,GetHitVar(hitcount) * .0085)
ignorehitpause = 1

[State -2, 重力補正];直前のhitcountが残る現象に対応
type = VarSet
trigger1 = Enemy,movetype != H
fvar(13) = 1.0000
ignorehitpause = 1

[State -2, 重力補正]
