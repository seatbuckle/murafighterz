;=============================================================================
; ヴァイタル回復
;=============================================================================
[State -2, クレセントのHEAT/B-HEAT時]
type = LifeAdd
trigger1 = roundstate = 2
trigger1 = GetHitVar(guarded) || (movetype != H && statetype = A) || (movetype != H && statetype = L) || (movetype = H && statetype = L) || (movetype != H && statetype != L)
trigger1 = NumHelper(11400)
trigger1 = helper(11400),fvar(1) > 0
trigger1 = var(58) = 1
trigger1 = var(6) = [2,3]
trigger1 = helper(11400),time%1 = 0
value = 2
ignorehitpause = 1

[State -2, フルのB-HEAT時]
type = LifeAdd
trigger1 = roundstate = 2
trigger1 = NumHelper(11400)
trigger1 = helper(11400),fvar(1) > 0
trigger1 = var(58) = 2 || var(58) = 4
trigger1 = var(6) = 3
value = Ceil(helper(11400),fvar(1)*16.12438)
ignorehitpause = 1

[State -2, フルのIH時]
type = LifeAdd
trigger1 = roundstate = 2
trigger1 = NumHelper(11400)
trigger1 = helper(11400),fvar(1) > 0
trigger1 = var(58) = 2 || var(58) = 4
trigger1 = var(25) = 2			;イニシアティブヒートフラグ
value = Ceil(helper(11400),fvar(1)*16.12438)
ignorehitpause = 1

[State -2, ハーフのHEAT時]
type = LifeAdd
trigger1 = roundstate = 2
trigger1 = GetHitVar(guarded) || (movetype != H && statetype = L) || (movetype = H && statetype = L) || (movetype != H && statetype != L)
trigger1 = NumHelper(11400)
trigger1 = helper(11400),fvar(1) > 0
trigger1 = var(58) = 3
trigger1 = var(6) = 2
trigger1 = helper(11400),time%1 = 0
value = 3
ignorehitpause = 1

