trigger1 = EnemyNear,stateno != 875	;生空投げ以外
trigger2 = EnemyNear,stateno = 1102
var(35) = 1
ignorehitpause = 1

[State -2, ダウン追撃フラグ加算]
type = VarAdd
trigger1 = var(35)
trigger1 = movehit
trigger1 = hitpausetime = 2
var(35) = 1
ignorehitpause = 1

[State -2, ダウン追撃フラグクリア]
type = VarSet
triggerall = var(35)
trigger1 = p2movetype != H
trigger2 = Enemy,GethitVar(hitcount) = 0
trigger3 = Enemy,stateno = 5120 && Enemy,time = 1
trigger4 = stateno = 2050 && movehit	;Cオリコン8C引き剥がし
trigger5 = p2statetype = L
trigger5 = stateno = 1421 && movehit	;C虎引き剥がし
trigger6 = stateno = 21421 && movehit	;H虎引き剥がし
trigger7 = stateno = 14702 && time = 1	;特殊ADヒット
trigger8 = stateno = 21250 && movehit	;H鐘楼ヒット
trigger9 = stateno = 31250 && movehit	;F鐘楼ヒット
trigger10 = enemy,stateno = 5120 && enemy,time >= 1	;起き上がり
trigger11 = (enemy,stateno = [10307,10308]) && enemy,movetype = H	;E跳ね返りナイフ引き剥がし
var(35) = 0
ignorehitpause = 1

