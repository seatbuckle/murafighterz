trigger1 = enemynear,HitDefAttr = SCA, NA
trigger1 = var(19) >= 51
trigger2 = enemynear,HitDefAttr = SCA, SA
trigger2 = var(19) >= 81
trigger3 = enemynear,HitDefAttr = SCA, HA, AP
trigger3 = var(19) >= 101
trigger4 = enemynear,HitDefAttr = SCA, NT
trigger4 = var(19) >= 11
trigger5 = enemynear,HitDefAttr = SCA, ST, HT
trigger5 = var(19) >= 21
var(19) = 2
ignorehitpause = 1

[State -3, カウンターフラグOFF]
