;=============================================================================
; ハーフのオートスパーク
;=============================================================================
; ※AD暗転前のサキスパ発動可否判定
; 　原作では、ADのコマンド入力から暗転までに相手側の攻撃でADが潰されると
; 　特例としてサキスパ(オートスパーク含む)は発動しない(できない)。
;
[State -3, AD暗転前のサキスパ発動可否判定ON]
type = VarSet
triggerall = !var(51)
triggerall = prevstateno = 4700 || prevstateno = 24700
trigger1 = stateno = 5000 && time <= 1
trigger2 = stateno = 5010 && time <= 1
trigger3 = stateno = 5020 && time <= 1
trigger4 = p2movetype = H	;相手が食らい中だとオートスパーク発動しない
var(51) = 1
ignorehitpause = 1

