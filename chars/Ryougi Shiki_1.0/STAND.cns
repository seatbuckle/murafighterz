;〓〓〓〓〓〓〓〓〓〓〓
; 試合終了時におけるMCゲージ状態判定
;〓〓〓〓〓〓〓〓〓〓〓
[State 1250, 試合終了時MCゲージ状態判定フラグ設定]
type = null
triggerall = !var(56)
triggerall = roundstate >= 3
trigger1 = var(6) = 1			;MAX中
trigger1 = var(56) := 1
trigger2 = var(6) = [2,3]		;HEAT/BLOOD HEAT中
trigger2 = var(56) := 2
ignorehitpause = 1

[State 1250, 試合終了時MCゲージ状態判定フラグ消去]
type = VarSet
trigger1 = var(56)
trigger1 = roundstate = 2
var(56) = 0
ignorehitpause = 1

[State -2, HEAT/BLOOD HEATで試合終了した場合、ランステ0にてPower0固定]
type = PowerSet
trigger1 = roundstate < 2
trigger1 = var(56) = 2
trigger1 = stateno = 0
value = 0
ignorehitpause = 1

[State -2, MAXで試合終了した場合、ランステ0にてPower固定（Cは2000,FとEは1000固定）]
type = PowerSet
trigger1 = roundstate < 2
trigger1 = var(56) = 1
trigger1 = stateno = 0
value = ifelse(var(58)=1,2000,ifelse(var(58)=2 || var(58)=4,1000,0))
ignorehitpause = 1

;〓〓〓〓〓〓〓〓〓〓〓
; その他
;〓〓〓〓〓〓〓〓〓〓〓
[State -2, MAX終了後のPower固定（Cは2000,Fは1000固定）]
type = PowerSet
triggerall = roundstate = 2
triggerall = var(6) = 1			;MCゲージ「MAX」
triggerall = fvar(1) < 0.1
trigger1 = Numhelper(11400) && helper(11400),var(2) = 0
trigger2 = Numhelper(11400) && helper(11400),var(2) = 1 && p2stateno != 1700	;両儀式に振り袖食らった場合は除外（サキブレだから）
value = ifelse(var(58)=1,2000,ifelse(var(58)=2 || var(58)=4,1000,0))
ignorehitpause = 1

[State -2, HEAT/BLOOD HEAT終了後のPower固定（全スタイル0固定）]
type = PowerSet
trigger1 = roundstate = 2
trigger1 = var(6) = [2,3]			;MCゲージ「HEAT/BLOOD HEAT」
trigger1 = fvar(1) < 0.1			;MCゲージ終了による0固定
value = 0
ignorehitpause = 1

