trigger1 = stateno != [5200,5210]
trigger1 = stateno != 904		;立ちProj飛び道具シールド成功時は発動対象外
trigger1 = stateno != 914		;しゃがみProj飛び道具シールド成功時は発動対象外
trigger1 = !var(51)			;AD暗転前に攻撃食らった場合は発動しない（原作ver1.07処理）
value = 930
ignorehitpause = 0

