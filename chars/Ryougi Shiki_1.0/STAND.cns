trigger1 = var(7)
var(7) = -1

[State -2, スロー処理]
type = Pause
triggerall = var(7)
triggerall = gametime%2
trigger1 = !winko
trigger2 = anim = 4803 && winko
time = 1
movetime = 0

[State -2, スローフラグOFF]
type = VarSet
trigger1 = var(7) <= 0
trigger1 = movetype = H
var(7) = 0

