; イニシアティブヒート（フル/「」スタイルのみ）
;=============================================================================
[State -2, イニシアティブヒート発動（ヒットorコンタクト用）]
type = VarSet
triggerall = roundstate = 2
triggerall = alive
triggerall = !var(25)&&!var(59)
triggerall = (var(6) = 1 && var(58) = 2) || (var(6) = 1 && var(58) = 4)
triggerall = movecontact
triggerall = hitshakeover
triggerall = command != "投げ"
triggerall = command = "強制開放"
trigger1 = hitdefattr = SCA,NA	;通常技
trigger2 = stateno = 1601 || stateno = 31601	;無明の月_A
trigger3 = stateno = 1611 || stateno = 31611	;無明の月_B
trigger4 = stateno = 1621 || stateno = 31621	;無明の月_EX
trigger5 = stateno = 31125	;双ね鐘楼 追加技2(236C)(フルムーン)
trigger6 = stateno = 31150	;双ね鐘楼 追加技3(足払い)(フルムーン)
var(25) = 1

[State -2, イニシアティブヒート発動（空振り用）]
type = VarSet
triggerall = roundstate = 2
triggerall = alive
triggerall = !var(25)&&!var(59)
triggerall = (var(6) = 1 && var(58) = 2) || (var(6) = 1 && var(58) = 4)
triggerall = command != "投げ"
triggerall = command = "強制開放"
trigger1 = stateno = 1611 || stateno = 31611	;214Bヒット時(フルムーン)
trigger1 = movecontact
trigger2 = stateno = 1611 || stateno = 31611	;214B無ヒット時(フルムーン)
trigger2 = !movecontact
trigger2 = time >= 16 && time <= 28
trigger3 = stateno = 1601 || stateno = 31601	;214B無ヒット時(フルムーン)
trigger3 = !movecontact
trigger3 = time >= 20 && time <= 28
trigger4= stateno = 31150	;双ね鐘楼 追加技3(足払い)(フルムーン)
trigger4 = !movecontact
trigger4 = time >= 1
trigger5= stateno = 31125	;双ね鐘楼 追加技2(236C)(フルムーン)
trigger5 = !movecontact
trigger5 = animelemtime(2) < 0
var(25) = 1

