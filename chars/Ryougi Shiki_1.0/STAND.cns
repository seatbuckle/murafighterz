;=============================================================================
; シールドカウンター（フル/イクリプス）
; ※ハーフのオートシールドカウンターのみ、shiki.cnsのシールドステ内で設定
;=============================================================================
[State -2, 立ちシールドカウンター]
type = ChangeState
triggerall = var(58) = 2 || var(58) = 4		;フル/イクリプス
triggerall = movetype != H
triggerall = command = "シールドカウンター"
trigger1 = stateno = 901 && movecontact		;打撃or飛び道具(H)シールド成功
trigger2 = var(21)				;飛び道具(P)シールド成功
trigger2 = stateno = 902
trigger3 = stateno = 911 && movecontact		;打撃or飛び道具(H)シールド成功
trigger4 = var(21)				;飛び道具(P)シールド成功
trigger4 = stateno = 912
value = 610

[State -2, 空中シールドカウンター]
