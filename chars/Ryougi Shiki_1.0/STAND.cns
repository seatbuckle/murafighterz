[State -3, イントロムーバー振り向き]
type = Turn
triggerall = Ishelper
triggerall = Numhelper(22222)
triggerall = stateno != [107,115]	;Fダッシュ、空ダ中は除外
trigger1 = stateno = 0 && time = 1
trigger1 = facing != Enemy,facing && p2dist X <= 0	;立ち
trigger2 = stateno = 40 && time = 1
trigger2 = facing != Enemy,facing && p2dist X <= 0	;ジャンプ開始
trigger3 = stateno = 10 && time = 1
trigger3 = facing != Enemy,facing && p2dist X <= 0	;しゃがみ開始
trigger4 = stateno = 20 && time >= 1
trigger4 = facing != Enemy,facing && p2dist X < 0	;歩き開始
trigger5 = stateno = 11 && time = 1
trigger5 = facing != Enemy,facing && p2dist X <= 0	;しゃがみ開始
trigger6 = NumEnemy					;⑨氏対策（ただし、以下の行動中は振り向かない）
trigger6 = Enemy,authorname = "⑨"
trigger6 = facing = Enemy,facing
trigger6 = stateno != [100,107]				;ダッシュ、バクステ対象外
trigger6 = stateno != [110,115]				;空ダ、空バクステ対象外
trigger6 = stateno != 50				;ジャンプ対象外
trigger6 = stateno != [2,3]				;2段ジャンプ対象外
ignorehitpause = 1

[State -3, イントロムーバー消去]
