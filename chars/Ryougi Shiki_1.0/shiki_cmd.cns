;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
;クレセントムーンスタイル超必殺技
;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
[State -1,直死の魔眼　五景崩落（クレセントムーン）]
type = ChangeState
value = 4700
triggerall = !winko    		;共通トリガ
triggerall = !IsHelper 		;共通トリガ
triggerall = !var(59)  		;AI OFFの場合
triggerall = var(58) = 1	;クレセントムーン
triggerall = var(6) = [1,2]	;MAX/HEAT状態の場合
triggerall = command = "直死の魔眼"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = stateno = [200,250]	;ジャンプ攻撃と特殊技以外
trigger2 = movecontact
trigger3 = stateno = 500	;BB
trigger3 = movecontact
trigger4 = stateno = 520 && movehit	;→C(空中ヒット)
trigger4 = EnemyNear,statetype = A
trigger5 = stateno = 520 && moveguarded	;→C(ガード)
trigger6 = stateno = 101 && time >= 1	;ダッシュランド
trigger7 = stateno = 200 || stateno = 230	;A系統空キャン
trigger7 = animelemtime(2) >= 1
trigger7 = !movecontact

[State -1,直死の魔眼　七景終落（クレセントムーン）]
type = ChangeState
value = 4750
triggerall = !winko    		;共通トリガ
triggerall = !IsHelper 		;共通トリガ
triggerall = !var(59)  		;AI OFFの場合
triggerall = var(58) = 1	;クレセントムーン
triggerall = var(6) = 3		;BLOOD HEAT状態の場合
triggerall = command = "直死の魔眼"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = stateno = [200,250]	;ジャンプ攻撃と特殊技以外
trigger2 = movecontact
trigger3 = stateno = 500	;BB
trigger3 = movecontact
trigger4 = stateno = 520 && movehit	;→C(空中ヒット)
trigger4 = EnemyNear,statetype = A
trigger5 = stateno = 520 && moveguarded	;→C(ガード)
trigger6 = stateno = 101 && time >= 1	;ダッシュランド
trigger7 = stateno = 200 || stateno = 230	;A系統空キャン
trigger7 = animelemtime(2) >= 1
trigger7 = !movecontact

;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
;ハーフムーンスタイル超必殺技
;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
[State -1,直死の魔眼　五景崩落（クレセントムーン）]
type = ChangeState
value = 24700
triggerall = !winko    		;共通トリガ
triggerall = !IsHelper 		;共通トリガ
triggerall = !var(59)  		;AI OFFの場合
triggerall = var(58) = 3	;ハーフムーン
triggerall = var(6) = 2		;HEAT状態の場合
triggerall = command = "直死の魔眼"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = stateno = [202,252]	;ジャンプ攻撃と特殊技以外
trigger2 = movecontact
trigger3 = stateno = 502	;BB
trigger3 = movecontact
trigger4 = stateno = 542	;3C
trigger4 = movecontact
trigger5 = stateno = 101 && time >= 1	;ダッシュランド
trigger6 = stateno = 202 && time >= 11	;5Aリバビシールド

