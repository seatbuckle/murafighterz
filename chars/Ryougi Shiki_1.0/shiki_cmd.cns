;=============================================================================
; 2段ジャンプ判定フラグ
;=============================================================================
[State -2, 上方向キー入力判定フラグON]
Type = VarSet
trigger1 = statetype = A
trigger1 = command = "holdup"
var(47) = 1

[State -2, 上方向キー入力判定フラグOFF]
Type = VarSet
trigger1 = statetype = A
trigger1 = command != "holdup"
trigger2 = statetype != A
var(47) = 0

[State -1,シールドバンカー]
type = ChangeState
value = 960
triggerall = !winko    ;共通トリガ
triggerall = Alive     ;生存時
triggerall = !IsHelper ;共通トリガ
triggerall = !var(59)  ;AI OFFの場合
triggerall = command = "シールドバンカー"
triggerall = statetype != A
trigger1 = ctrl
;===ハーフ設定===
trigger2 = stateno = [202,252]	;ジャンプ攻撃と特殊技以外
trigger2 = movecontact
trigger3 = stateno = 502	;BB
trigger3 = movecontact
trigger4 = stateno = 532
trigger4 = movecontact		;←C
trigger5 = stateno = 542
trigger5 = movecontact		;3C
trigger6 = stateno = 590
trigger6 = movecontact		;5A追加6A - 1
trigger7 = stateno = 600
trigger7 = movecontact		;5A追加6A - 2
trigger8 = stateno = 610
trigger8 = movecontact		;立ちシールドカウンター
trigger9 = stateno = 620
trigger9 = movecontact		;しゃがみシールドカウンター
;===クレセント設定===
trigger10 = stateno = [200,250]	;ジャンプ攻撃と特殊技以外
trigger10 = movecontact
trigger11 = stateno = 500			;BB
trigger11 = movecontact
trigger12 = stateno = 520 && movehit		;→C(空中ヒット)
trigger12 = EnemyNear,statetype = A
trigger13 = stateno = 520 && moveguarded	;→C(ガード)
trigger14 = stateno = 101 && time >= 1		;ダッシュランド
;===フル設定===
trigger15 = stateno = [201,251]	;ジャンプ攻撃と特殊技以外
trigger15 = movecontact
trigger16 = stateno = 540
trigger16 = movecontact		;←C
trigger17 = stateno = 550
trigger17 = movecontact		;3C
trigger18 = stateno = 610
trigger18 = movecontact		;立ちシールドカウンター
trigger19 = stateno = 501
trigger19 = movecontact		;立ちC
;===全スタイルA系空キャン設定===
trigger20 = stateno = 200 || stateno = 230	;クレ
trigger20 = animelemtime(2) >= 1
trigger20 = !movecontact
trigger21 = stateno = 201			;フル
trigger21 = animelemtime(2) >= 1
trigger21 = !movecontact
trigger22 = stateno = 202 || stateno = 232	;ハーフ
trigger22 = animelemtime(2) >= 1
trigger22 = !movecontact

[State -1,シールドバンカー(GC)]
type = ChangeState
value = 965
triggerall = !winko    ;共通トリガ
triggerall = Alive     ;生存時
triggerall = !IsHelper ;共通トリガ
triggerall = !var(59)  ;AI OFFの場合
triggerall = command = "シールドバンカー"
triggerall = statetype != A
trigger1 = var(58) = 4 || var(58) = [1,2]			;クレセント/フル/イクリプスは50%
trigger1 = GetHitVar(guarded)
trigger1 = !hitshakeover
trigger1 = (!var(6) && power >= 500) || var(6)
trigger2 = var(58) = 3				;ハーフは100%
trigger2 = GetHitVar(guarded)
trigger2 = !hitshakeover
trigger2 = (!var(6) && power >= 1000) || var(6)
trigger3 = var(58) = 4				;イクリプスはノーゲージ
trigger3 = GetHitVar(guarded)
trigger3 = !hitshakeover

