;---------------------------------------------------------------------------
[Statedef -1]

;---------------------------------------------------------------------------
; ジャンプキャンセル
;---------------------------------------------------------------------------
[State -1, ジャンプキャンセル]
type = ChangeState
value = 40
triggerall = !winko          					;共通トリガ
triggerall = !IsHelper       					;共通トリガ
triggerall = !var(59)        					;AI OFFの場合
triggerall = !var(27)        					;ジャンプキャンセル可の場合
triggerall = command = "holdup"
triggerall = movehit
trigger1 = stateno = [200,250]					;J攻撃以外（クレセント）
trigger2 = stateno = 500 					;BB（クレセント）
trigger3 = stateno = 520 && EnemyNear,statetype = A 		;→C(空中ヒット時限定)
trigger3 = !var(11)	;相手がダウンしてない場合
trigger4 = stateno = [202,252]					;J攻撃以外（ハーフ）
trigger5 = stateno = 502 					;BB（ハーフ）
trigger6 = stateno = 542 					;3C（ハーフ）
trigger7 = stateno = [590,600] 					;5Aからの追加2種（ハーフ）
trigger8 = stateno = 610 					;立ちシールドカウンター（ハーフ）
trigger9 = stateno = 540 					;←C（フル）
trigger10 = stateno = 550 					;3C（フル）
trigger11 = var(58) = 4
trigger11 = stateno = [510,530] 				;各種BE(イクリプス限定)
trigger12 = stateno = 511 					;5C(BE)（フル）
trigger12 = p2stateno = 1305
trigger13 = stateno = 21250 && animelemtime(33) >= 0		;236EX（ハーフ）
trigger14 = stateno = 31250 && animelemtime(33) >= 0		;236EX（フル）
ctrl = 1

[State -1, ダッシュ停止アニメ時ジャンプ可能設定]
type = ChangeState
value = 40
triggerall = !winko          ;共通トリガ
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = command = "holdup"
trigger1 = stateno = 101 && time >= 1
ctrl = 1

[State -1, ござるのために・・・！]
type = ChangeState
value = 0
triggerall = winko          ;共通トリガ
triggerall = !IsHelper       ;共通トリガ
triggerall = !var(59)        ;AI OFFの場合
triggerall = command = "holdfwd" || command = "holdback"
triggerall = statetype != A
triggerall = stateno != 0
triggerall = stateno != [200,999]	;全通常技
trigger1 = ctrl


