trigger1 = Enemy,movetype = H
trigger1 = Enemy,GethitVar(hitcount) = 20
trigger1 = root,hitpausetime = 2
trigger1 = var(24) < 10
var(24) = 2
persistent = 999
ignorehitpause = 1

[State 10023, 10ヒット以上コンボ実行総数カウント(30ヒット以上)]
