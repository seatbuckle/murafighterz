; ゲージ量決定（最大60.0）
;〓〓〓〓〓〓〓〓〓〓〓〓〓
[State 11300, ゲージ量初期化and最大値固定]
type = VarSet
trigger1 = fvar(1) <= 0					;ガードブレイク発生時
trigger1 = root,movetype != H
trigger1 = root,stateno != [130,156]
trigger2 = fvar(1) > 60.0				;フェールセーフ
fv = 1
value = 60.0
ignorehitpause = 1

[State 11300, ゲージ最小値固定設定]
type = VarSet
trigger1 = fvar(1) <= 0
fv = 1
value = 0
ignorehitpause = 1

;〓〓〓〓〓〓〓〓〓〓〓〓〓
; ゲージ減少
;〓〓〓〓〓〓〓〓〓〓〓〓〓
[State 11300, ゲージ減少(通常)]
type = Varadd
trigger1 = roundstate = 2
trigger1 = root,var(58) != 4	;Eはガードゲージ割れない
trigger1 = !var(22)
trigger1 = !root,var(34)
trigger1 = alive
trigger1 = fvar(1) > 0
trigger1 = !var(1)	;グレースケール表示時は減少なし
trigger1 = root,stateno = 150 ||  root,stateno = 152 || root,stateno = 154
trigger1 = root,time = 1
trigger1 = root,hitshakeover = 0
fv = 1
value = ifelse(root,var(58)=1,-1.6, ifelse(root,var(58)=2,-1.0, ifelse(root,var(58)=4,-1.6, -1.0)))
ignorehitpause = 1

[State 11300, ゲージ減少(Lv1)]
type = Varadd
trigger1 = roundstate = 2
trigger1 = root,var(58) != 4	;Eはガードゲージ割れない
trigger1 = var(22)
trigger1 = !root,var(34)
trigger1 = alive
trigger1 = fvar(1) > 0
trigger1 = !var(1)	;グレースケール表示時は減少なし
trigger1 = root,stateno = 150 ||  root,stateno = 152 || root,stateno = 154
trigger1 = root,time = 1
trigger1 = root,hitshakeover = 0
fv = 1
value = ifelse(root,var(58)=1,-1.7, ifelse(root,var(58)=2,-1.1, ifelse(root,var(58)=4,-1.7, -1.1)))
ignorehitpause = 1

[State 11300, ゲージ減少(Lv2)]
type = Varadd
trigger1 = roundstate = 2
trigger1 = root,var(58) != 4	;Eはガードゲージ割れない
trigger1 = var(23)
trigger1 = !root,var(34)
trigger1 = alive
trigger1 = fvar(1) > 0
trigger1 = !var(1)	;グレースケール表示時は減少なし
trigger1 = root,stateno = 150 ||  root,stateno = 152 || root,stateno = 154
trigger1 = root,time = 1
trigger1 = root,hitshakeover = 0
fv = 1
value = ifelse(root,var(58)=1,-1.9, ifelse(root,var(58)=2,-1.3, ifelse(root,var(58)=4,-1.9, -1.3)))
ignorehitpause = 1

;〓〓〓〓〓〓〓〓〓〓〓〓〓
; ゲージ回復
;〓〓〓〓〓〓〓〓〓〓〓〓〓
[State 11300, ゲージ回復開始判定ON]
type = VarAdd
trigger1 = roundstate = 2
trigger1 = root,var(58) != 4	;Eはガードゲージ割れない
trigger1 = root,movetype = H
trigger1 = !root,GetHitVar(guarded)
trigger1 = fvar(1) < 60
trigger1 = !var(0)
trigger1 = !var(1)	;グレースケール時の回復とは別物
var(0) = 1
ignorehitpause = 1

[State 11300, ゲージ回復開始判定OFF]
type = VarSet
triggerall = roundstate = 2
triggerall = root,var(58) != 4	;Eはガードゲージ割れない
triggerall = !var(1)	;グレースケール時の回復とは別物
trigger1 = fvar(1) >= 60
trigger1 = var(0)
trigger2 = root,movetype = H
trigger2 = root,GetHitVar(guarded)
var(0) = 0
ignorehitpause = 1

[State 11300, ゲージ回復(通常)]
type = VarAdd
trigger1 = roundstate = 2
trigger1 = var(0)	;ゲージ回復開始判定ON
trigger1 = !var(1)	;グレースケール時の回復とは別物
fv = 1
value = ifelse(root,var(58)!=4,0.06, 0.41)	;イクリプスと差別化
ignorehitpause = 1

[State 11300, ゲージ回復(グレースケール時)]
