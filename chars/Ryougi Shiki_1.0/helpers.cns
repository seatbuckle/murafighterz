;〓〓〓〓〓〓〓〓〓〓〓〓
; 呼び出し種別振り分け
;〓〓〓〓〓〓〓〓〓〓〓〓
[State 11250, 振り分け]
type = Null
triggerall = time = 0
triggerall = !var(59)
trigger1 = root,var(6) = 1				;メッセージ「MAX」表示
trigger1 = root,fvar(1) >= 299
trigger1 = root,var(58) = 4 || root,var(58) = [1,2]
trigger1 = var(59) := 1
trigger2 = root,var(6) = 2				;メッセージ「HEAT」表示
trigger2 = root,stateno = 580 && root,animelem = 2
trigger2 = root,var(58) = 4 || root,var(58) = [1,2]
trigger2 = var(59) := 2
trigger3 = root,var(6) = 3				;メッセージ「BLOOD HEAT」表示
trigger3 = root,stateno = 580 && root,animelem = 2
trigger3 = root,var(58) = 4 || root,var(58) = [1,2]
trigger3 = var(59) := 3
trigger4 = root,stateno = 930 || root,stateno = 935	;メッセージ「サキスパ」表示
trigger4 = root,time = 2
trigger4 = var(59) := 4
trigger5 = root,movecontact
trigger5 = root,stateno = 900 || root,stateno = 910 || root,stateno = 920
trigger5 = var(59) := 5					;メッセージ「EX Shield!」表示
trigger6 = root,stateno = 903 || root,stateno = 913 || root,stateno = 923
trigger6 = var(59) := 5					;メッセージ「EX Shield!」表示
trigger7 = root,movecontact
trigger7 = root,stateno = 901 || root,stateno = 911 || root,stateno = 921
trigger7 = var(59) := 6					;メッセージ「Shield!」表示
trigger8 = root,stateno = 904 || root,stateno = 914 || root,stateno = 924
trigger8 = var(59) := 6					;メッセージ「Shield!」表示
trigger9 = root,var(6) = 2				;メッセージ「HEAT」表示（ハーフムーン/「」スタイル用）
trigger9 = root,var(58) = 3
trigger9 = root,fvar(1) >= 199
trigger9 = var(59) := 2
trigger10 = root,fvar(19)				;メッセージ「クリティカル」表示
trigger10 = var(59) := 7
trigger11 = root,var(30) = 3				;メッセージ「リバースビート」表示
trigger11 = var(59) := 8
trigger12 = root,var(25)				;メッセージ「イニシアティブヒート」表示
