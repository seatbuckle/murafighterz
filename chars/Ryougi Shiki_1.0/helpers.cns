;------------------------------------------------------------------------------
; 隠しナイフ - 軌道
[Statedef 10600]
type = S
physics = N
anim = 13480
velset = 0,0
sprpriority = 0
ctrl = 0

[State 10600, 暫定？これ入れるとナイフが出てる間は画面揺れしなくなる]
type = EnvShake
trigger1 = 1
time = 0
ampl = 0
ignorehitpause = 1

[State 10600, parentID]
type = Varset
trigger1 = time = 0
var(0) = parent,ID
ignorehitpause = 1

[State 10600, turn]
type = Turn
trigger1 = playeridexist(var(0))
trigger1 = facing != parent,facing
ignorehitpause = 1

[State 10600, bindtoroot]
type = PosSet
trigger1 = playeridexist(var(0))
x = parent,pos x
y = parent,pos y
ignorehitpause = 1

[State 10600, angleset]
type = Angleset
trigger1 = parent,vel y = 0
trigger2 = parent,vel x = 0
value = 0
ignorehitpause = 1

[State 10600, angleset]
type = Angleset
trigger1 = playeridexist(var(0))
trigger1 = parent,vel y != 0
trigger1 = parent,vel x != 0
value = -180.0 / pi * atan(parent,vel y / parent,vel x)
ignorehitpause = 1

[State 10600, angleset];点から線へ(ベクトルの長さに合わせて伸縮)
type = Varset
trigger1 = playeridexist(var(0))
fvar(0) = (parent,vel x*parent,vel x+parent,vel y*parent,vel y)**.5
ignorehitpause = 1

[State 10600, angledraw]
type = AngleDraw
trigger1 = 1
scale = fvar(0), 2
ignorehitpause = 1

[State 10600, palfx]
type = PalFX
trigger1 = 1
time = -1
add = -(256-150),-(256-150),-(256-150)
ignorehitpause = 1

[State 10600, 直前の座標と同じなら残像消す]
type = AfterImageTime
trigger1 = playeridexist(var(0))
trigger1 = time > 0
trigger1 = floor(parent,pos x) = floor(fvar(1))
trigger1 = floor(parent,pos y) = floor(fvar(2))
trigger1 = parent,pos y < 0
trigger1 = fvar(3) := 2 || 1
time = 0

[State 10600, 直前の座標と同じでないなら残像再開]
type = VarSet
triggerall = playeridexist(var(0))
triggerall = fvar(3) = 2
trigger1 = floor(parent,pos x) != floor(fvar(1))
trigger2 = floor(parent,pos y) != floor(fvar(2))
fvar(3) = 1

[State 10600, 残像]
type = AfterImage
trigger1 = time = 0 || fvar(3) = 1
trigger1 = fvar(3) := 0 || 1
time = -1
length = 60
timegap = 1
framegap = 1
palcontrast = 150,150,150
palpostbright = 0,0,0
paladd = -8,-8,-8
palmul = 1,1,1
trans = add
ignorehitpause = 1

[State 10600, playerpush]
type = PlayerPush
trigger1 = 1
value = 0
ignorehitpause = 1

[State 10600, ステート終了タイミング]
type = VarSet
trigger1 = playeridexist(var(0))
trigger1 = parent,pos y >= 0
trigger1 = !parent,vel x
trigger1 = !parent,vel y
trigger2 = !playeridexist(var(0))
var(1) = 1
ignorehitpause = 1

[State 10600, ステート終了タイマ]
type = VarAdd
trigger1 = var(1)
var(2) = 1
ignorehitpause = 1

[State 10600, 直前の座標(x)]
type = VarSet
trigger1 = 1
fvar(1) = pos x
ignorehitpause = 1

[State 10600, 直前の座標(y)]
type = VarSet
trigger1 = 1
fvar(2) = pos y
ignorehitpause = 1

[State 10600, destroy]
type = DestroySelf
trigger1 = var(2) >= 60;最後の残像が消えるまで待つ
trigger2 = !playeridexist(var(0))
ignorehitpause = 1

