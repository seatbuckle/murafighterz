; 40000         BLOOD HEATオーラ - メイン
; 40001         BLOOD HEATオーラ - ハウリング


;---------------------------------------------------------------------------
; BLOOD HEATオーラ - メイン
[Statedef 40000]
movetype = I
velset = 0,0
ctrl = 0
anim = 99999
sprpriority = 0

[State 40000, 影なし]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 40000, 念の為に無敵]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 40000, ターン]
type = Turn
trigger1 = facing != root,facing
ignorehitpause = 1

[State 40000, 位置固定]
type = BindToRoot
trigger1 = 1
pos = -1,-1
ignorehitpause = 1

[State 40000, エレメント同期]
type = ChangeAnim
trigger1 = SelfAnimExist(40000+root,anim)
value = 40000 + root,anim
elem = root,animelemno(0)
ignorehitpause = 1

[State 40000, 同期できるアニメがなければ非表示]
type = ChangeAnim
trigger1 = !SelfAnimExist(40000+root,anim)
value = 99999
ignorehitpause = 1

[State 40000, ステ奪われ食らいは非表示にする]
type = AssertSpecial
trigger1 = root,movetype = H && root,stateno < 5000
trigger1 = !root,gethitvar(guarded)
flag = invisible
ignorehitpause = 1

[State 40000, カラー変更]
type = PalFX
trigger1 = 1
time = 1
add = 255*(root,var(6)%10!=[1,2]),255*(root,var(6)%10!=[1,2]),255*(root,var(6)%10=[1,2])
ignorehitpause = 1

[state 40000, 透過実施]
type = Trans
trigger1 = 1
trans = AddAlpha
alpha = Ceil(ifelse(Time%48>23,160-Time%24*(160/24),Time%24*(160/24))),256

[State 40000, ハウリングヘルパー起動]
type = Helper
trigger1 = timemod = 3,0
trigger1 = anim != 99999
stateno = 40001
ID = 40001
pos = 0,0
postype = p1
ownpal = 0	;40000内のPalFXを継承する
supermovetime = 99999
ignorehitpause = 1

[State 40000, 消去]
type = DestroySelf
trigger1 = root,var(6) != [1,3]	;正規

;---------------------------------------------------------------------------
; BLOOD HEATオーラ - ハウリング
[Statedef 40001]
movetype = I
velset = 0,0
ctrl = 0
sprpriority = -1

[State 40001, 影なし]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 40001, 念の為に無敵]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 40001, 拡大実施]
type = AngleDraw
trigger1 = 1
scale = 1.0+.005*Time,1.0+.005*Time

[State 40001, 透過実施]
type = Trans
trigger1 = 1
trans = AddAlpha
alpha = ceil(80-Time%13*(80/12)),256

[State 40001, メインヘルパーのアニメ番号を格納]
type = VarSet
trigger1 = time = 0
var(1) = parent,anim

[State 40001, メインヘルパーのエレメント番号を格納]
type = VarSet
trigger1 = time = 0
var(2) = parent,AnimElemNo(0)

[State 40001, アニメ / エレメント決定]
type = ChangeAnim
trigger1 = var(1) != 99999
value = var(1)
elem = var(2)
ignorehitpause = 1

[State 40001, 同期できるアニメがなければ非表示]
type = ChangeAnim
trigger1 = var(1) = 99999
value = 99999
ignorehitpause = 1

[State 40001, ステ奪われ食らいは非表示にする]
type = AssertSpecial
trigger1 = root,movetype = H && root,stateno < 5000	;ステ奪われ時
trigger1 = !root,gethitvar(guarded)
flag = invisible
ignorehitpause = 1

[State 40001, 消去]
type = DestroySelf
trigger1 = time >= 12

;---------------------------------------------------------------------------
; EXガード時プッシュヘルパー
[Statedef 14]
type = S
movetype = I
anim = 0
velset = 0,0
ctrl = 0

[State 14, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 14, 透明化]
type = AssertSpecial
trigger1 = 1
flag = invisible
ignorehitpause = 1

[State 14, 位置固定]
type = BindToRoot
trigger1 = time = 0
pos = 20,0
persistent = 0
ignorehitpause = 1

[State 14, 速度]
type = VelSet
trigger1 = time = 0
x = ifelse(root,backedgedist >=12,-8,8)
persistent = 0
ignorehitpause = 1

[State 14, プッシュ実施]
type = PlayerPush
trigger1 = 1
value = 1
ignorehitpause = 1

[State 14, 終了]
type = DestroySelf
trigger1 = time >= 3

;---------------------------------------------------------------------------
; イントロでのカラー決め専用棺（棺本体）
[Statedef 113]
type = S
anim = 99999
velset = 0,0
ctrl = 0

[State 113, 終了]
type = DestroySelf
trigger1 = time >= 27

;---------------------------------------------------------------------------
; 画面端判定ヘルパー
[Statedef 112]
type = A
anim = 99999
velset = 0,0
ctrl = 0

[State 112, 距離測定]
type = VarSet
trigger1 = fvar(enemynear(!enemynear,alive*enemy,alive),pos x<0) > p2dist X
trigger1 = enemynear(!enemynear,alive*enemy,alive),BackEdgeDist >=0 && enemynear(!enemynear,alive*enemy,alive),FrontEdgeDist >=0
fv = enemynear(!enemynear,alive*enemy,alive),pos x<0
value = p2dist X
ignorehitpause = 1

[State 112, 本体固定]
type = BindToRoot
trigger1 = 1
facing = -1
pos = 99999,0
ignorehitpause = 1

[State 112, オールvarクリア]
type = VarRangeSet
trigger1 = time = 0
fvalue = 99999.00
first = 0
last = 1
ignorehitpause = 1

[State 112, 画面端判定var設定]
type = ParentVarSet
trigger1 = fvar(enemynear(!enemynear,alive*enemy,alive),pos x<0) <= p2dist X
fvar(12) = p2dist X-fvar(enemynear(!enemynear,alive*enemy,alive),pos x<0)
ignorehitpause = 1

[State 112, 消去]
type = DestroySelf
trigger1 = roundstate > 3

;------------------------------------------------------------------------------
; C6C斬撃エフェクト
[StateDef 10035]
type = S
physics = N
anim = 10030
velset = 0,0
ctrl = 0
sprpriority = 2

[State 10058, 角度]
type = AngleDraw
trigger1 = 1
value = -20
scale = 1.0,0.8

[state 10058, 透過]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256, 256
ignorehitpause = 1

[State 10058, 影なし]
type = AssertSpecial
trigger1 = 1
flag = Noshadow
ignorehitpause = 1

[State 10058, 消去]
type     = DestroySelf
trigger1 = animtime = 0

;------------------------------------------------------------------------------
; 波動三段ラスト236C斬撃エフェクト
[StateDef 10036]
type = S
physics = N
anim = 100350
velset = 0,0
ctrl = 0
sprpriority = 2

[State 10036, バインド]
type = BindtoParent
trigger1 = 1
pos = 29,-47
ignorehitpause = 1

[State 10036, 角度]
type = AngleDraw
trigger1 = 1
value = 38-(time*2.6)
scale = 1.2+(time*0.2),1.3
ignorehitpause = 1

[state 10036, 透過]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256, 256
ignorehitpause = 1

[State 10036, 影なし]
type = AssertSpecial
trigger1 = 1
flag = Noshadow
ignorehitpause = 1

[State 10036, 消去]
type     = DestroySelf
trigger1 = animtime = 0

;--------------------------------------------------------------------------
;アクションゲージ
[Statedef 11170]
type = S
anim = 99999

[State 11170, ヒットポーズタイム取得]
type = VarSet
trigger1 = !var(2)
trigger1 = !root,hitshakeover
var(2) = root,gethitvar(hitshaketime)-2
ignorehitpause = 1

[State 11170, ヒットポーズタイムクリア]
type = VarSet
trigger1 = var(2)
trigger1 = root,hitshakeover
var(2) = 0
ignorehitpause = 1

[State 11170, リカバータイム取得、リカバー不可の場合は「-1」を設定]
type = VarSet
trigger1 = !root,hitshakeover
var(1) = ifelse(root,gethitvar(fall.recover),root,gethitvar(fall.recovertime)-var(2),-1)
ignorehitpause = 1

[State 11170, リカバータイム取得後、減算]
type = VarAdd
trigger1 = var(1) > 0
var(1) = -1
ignorehitpause = 1

[State 11170, リカバー不可フラグ設定]
type = VarSet
trigger1 = var(1) != -1
trigger1 = root,movetype = H
trigger1 = root,stateno != [5000,5999]
var(1) = -1
ignorehitpause = 1

[State 11170, ゲージ枠 - 1P側]
type = Explod
trigger1 = !NumExplod(14010)
trigger1 = teamside = 1
trigger1 = time = 0
anim = 14010
id = 14010
pos = 10,60
postype = left
bindtime = 999999999999999
pausemovetime = 999999999999999
supermovetime = 999999999999999
scale = 0.5,0.5
sprpriority = 10
ownpal = 1
ignorehitpause = 1

[State 11170, ゲージ枠 - 2P側]
type = Explod
trigger1 = !NumExplod(14010)
trigger1 = teamside = 2
trigger1 = time = 0
anim = 14010
id = 14010
pos = -100,60
postype = right
bindtime = 999999999999999
pausemovetime = 999999999999999
supermovetime = 999999999999999
scale = 0.5,0.5
sprpriority = 10
ownpal = 1
ignorehitpause = 1

[State 11170, ゲージ本体毎F消去]
type = RemoveExplod
trigger1 = NumExplod(14011)
id = 14011
ignorehitpause = 1

[State 11170, ゲージ本体 - 1P側]
