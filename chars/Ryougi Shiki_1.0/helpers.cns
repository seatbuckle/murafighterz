trigger1 = Enemy,movetype = H
trigger1 = Enemy,GethitVar(hitcount) >= 30
trigger1 = root,hitpausetime = 2
trigger1 = var(24) < 10
var(24) = 3
persistent = 999
ignorehitpause = 1

