;--------------------------------------------------------------------------
;スコアヘルパー
;var(0)		:パーフェクトボーナス値(30000)
;var(1)		:ライフボーナス1の位
;var(2)		:ライフボーナス10の位
;var(3)		:ライフボーナス100の位
;var(4)		:ライフボーナス1000の位
;var(5)		:ライフボーナス10000の位
;
;var(11)	:タイムボーナス1の位
;var(12)	:タイムボーナス10の位
;var(13)	:タイムボーナス100の位
;var(14)	:タイムボーナス1000の位
;var(15)	:ランダム（低）
;var(16)	:ランダム（中）
;var(17)	:ランダム（高）
;
;var(20)	:最大コンボ数格納ボックス
;var(21)	:コンボボーナス1の位
;var(22)	:コンボボーナス10の位
;var(23)	:コンボボーナス100の位
;var(24)	:コンボボーナス1000の位
;var(25)	:コンボボーナス10000の位
;
;var(30)	:ボーナストータル値
;
[Statedef 10023]
type = S
sprpriority = 5
anim = 99999

;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
; ライフボーナス前準備
;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
[State 10023, 一の位]
type = VarSet
trigger1 = win
var(1) = 0
persistent = 0
ignorehitpause = 1

[State 10023, 十の位]
type = VarSet
trigger1 = win
var(2) = floor(root,life)%10
persistent = 0
ignorehitpause = 1

[State 10023, 百の位]
type = VarSet
trigger1 = win
var(3) = floor(root,life/10)%10
persistent = 0
ignorehitpause = 1

[State 10023, 千の位]
type = VarSet
trigger1 = win
var(4) = floor(root,life/100)%10
persistent = 0
ignorehitpause = 1

[State 10023, 万の位]
type = VarSet
trigger1 = win
var(5) = floor(root,life/1000)%10
persistent = 0
ignorehitpause = 1

;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
; タイムボーナス前準備
;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
[State -2, ランダム（低）]
type = VarRandom
trigger1 = roundstate = 2
Trigger1=time%2
v = 15
range = 1,3

[State -2, ランダム（中）]
type = VarRandom
trigger1 = roundstate = 2
Trigger1=time%2
v = 16
range = 4,6

[State -2, ランダム（高）]
type = VarRandom
trigger1 = roundstate = 2
Trigger1=time%2
v = 17
range = 7,9

[State 10023, 一の位]
type = VarSet
trigger1 = win
var(11) = var(15)+var(16)
persistent = 0
ignorehitpause = 1

[State 10023, 十の位]
type = VarAdd
trigger1 = win
var(12) = var(15)+var(16)-1
persistent = 0
ignorehitpause = 1

[State 10023, 百の位]
type = VarSet
trigger1 = win
var(13) = ifelse(Ceil(time/60)>=30,var(16)-var(15), var(17)-1)
persistent = 0
ignorehitpause = 1

[State 10023, 千の位]
type = VarSet
trigger1 = win
var(14) = ifelse(Ceil(time/60)<=10,9, ifelse(Ceil(time/60)>10&&Ceil(time/60)<=20,var(17)-1, ifelse(Ceil(time/60)>20&&Ceil(time/60)<=30,var(16), 1)))
persistent = 0
ignorehitpause = 1

;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
; コンボボーナス前準備
;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
[State 10023, 最大コンボ数]
type = VarSet
trigger1 = Enemy,movetype = H
trigger1 = Enemy,GethitVar(hitcount) > var(20)
var(20) = Enemy,GethitVar(hitcount)
ignorehitpause = 1

[State 10023, 一の位]
type = VarSet
trigger1 = win
var(21) = var(20)%10
persistent = 0
ignorehitpause = 1

[State 10023, 十の位（10ヒット以上のコンボありの場合）]
type = VarSet
trigger1 = win
trigger1 = var(20) >= 10
var(22) = ifelse((var(20)/10)%10 < 9, (var(20)/10)%10+1, (var(20)/10)%10)
persistent = 0
ignorehitpause = 1

[State 10023, 十の位（10ヒット以下のコンボのみの場合）]
type = VarSet
trigger1 = win
trigger1 = var(20) < 10
var(22) = 1
persistent = 0
ignorehitpause = 1

[State 10023, 百の位]
type = VarSet
trigger1 = win
trigger1 = var(22)
var(23) = ifelse(var(22)+1>=10,9,var(22)+1)
persistent = 0
ignorehitpause = 1

[State 10023, 10ヒット以上コンボ実行総数カウント(10ヒットコンボ)]
type = VarAdd
trigger1 = Enemy,movetype = H
trigger1 = Enemy,GethitVar(hitcount) = 10
trigger1 = root,hitpausetime = 2
trigger1 = var(24) < 10
var(24) = 1
persistent = 999
ignorehitpause = 1

[State 10023, 10ヒット以上コンボ実行総数カウント(20ヒットコンボ)]
