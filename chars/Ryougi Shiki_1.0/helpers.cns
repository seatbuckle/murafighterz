[State 11170, 汎用]
type = DisplayToClipBoard
trigger1 = 1
text ="		var(1) = %d	fvar(1)=%f"
params =	var(1),		fvar(1)
supermovetime = 9999999
pausemovetime = 9999999
ignorehitpause = 1

[State 11170, ゲージ量設定]
type = VarSet
trigger1 = 1
trigger1 = var(1) != -1	;リカバー可能(recoveretimeが設定されている)場合
fvar(1) = ifelse(var(1)!=0,var(1)*0.01,0)
ignorehitpause = 1

[State 11170, ゲージ変動 - 1P側]
type = ModifyExplod
trigger1 = teamside = 1
trigger1 = var(1) != -1	;リカバー可能(recoveretimeが設定されている)場合
id = 14011
scale = ifelse(fvar(1)>=0.5,0.5, ifelse(fvar(1)<=0,0,fvar(1))),1.0
pos = 11,67
postype = left
ignorehitpause = 1

[State 11170, ゲージ変動 - 2P側]
type = ModifyExplod
trigger1 = teamside = 2
trigger1 = var(1) != -1	;リカバー可能(recoveretimeが設定されている)場合
id = 14011
scale = ifelse(fvar(1)>=0.5,0.5, ifelse(fvar(1)<=0,0,fvar(1))),1.0
pos = -9,67
postype = right
facing = -1
ignorehitpause = 1

