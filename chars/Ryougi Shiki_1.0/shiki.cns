;==============================================================================
; Varの使用状況
;==============================================================================
; var(0)   - ランダム変数
; var(1)   - 2段ジャンプフラグ（★転猫方向判定でも流用）
; var(2)   - 投げボイス決定フラグ（★段階BE判定/Fの波動3段2段目飛ばし、清姫セリフ判定でも流用）
; var(3)   - 隠しナイフ謎補正フラグ
; var(4)   - 空中ダッシュ回数カウンタ
; var(5)   - ロングジャンプ判定フラグ（★Hの3BC判定でも流用）
; var(6)   - マジックサーキット状態判定フラグ（0:通常 1:MAX 2:HEAT 3:BLOOD HEAT 4:サーキットブレイク）
; var(7)   - スローフラグ
; var(8)   - 清姫通しヒット中フラグ(黒背景実施有無を決定)
; var(9)   - 空の境界セリフ選択判定フラグ（★H4CKOフラグでも流用）
; var(10)  - 無我識入力判定フラグ
; var(11)  - ござる判定フラグ(★C6Cダウン追撃判定でも流用)
; var(12)  - 淘の振り袖発動フラグ
; var(13)  - シールドバンカー成功判定フラグ
; var(14)  - 無我識技2 初回判定フラグ
; var(15)  - 無我識　残り時間
; var(16)  - 受け身可能時間減算用コンボ数スタック
; var(17)  - ビートエッジ中攻撃実施有無判定フラグ
; var(18)  - 壁バウンド回数カウンタ
; var(19)  - カウンター判定
; var(20)  - クリティカル判定
; var(21)  - シールド成功種別判定フラグ
		1:立ちEX - S打撃 2:立ちEX - S飛び道具(H) 3:立ちEX - S飛び道具(P)
		4:立ち   - S打撃 5:立ち   - S飛び道具(H) 6:立ち   - S飛び道具(P)
		7:屈みEX - S打撃 8:屈みEX - S飛び道具(H) 9:屈みEX - S飛び道具(P)
		10:屈み  - S打撃 11:屈み  - S飛び道具(H) 12:屈み  - S飛び道具(P)
		13:空中EX -S打撃 14:空中EX -S飛び道具(H) 15:空中EX -S飛び道具(P)
		16:空中  - S打撃 17:空中  - S飛び道具(H) 18:空中  - S飛び道具(P)
; var(22)  - ワイヤー種別フラグ（1:強制開放　2:強制開放以外）※サキスパorオートスパーク可否判定に使用
; var(23)  - ヒット確認フラグ
; var(24)  - ダメージ値格納ボックス
; var(25)  - イニシアティブヒートフラグ
; var(26)  - ハイジャンプコマンド下入力時間判定フラグ
; var(27)  - ジャンプキャンセル可否判定フラグ
; var(28)  - 立ちシールド中経過時間（5F以内にP飛び道具当て身が成功したか否かの判定に使用（F/EのLA遷移のため））
; var(29)  - (12/10/8)コーナープッシュ補正
; var(30)  - リバースビートフラグ（スライドメッセージ表示判定に使用）
; var(31)  - ダッシュ中しゃがみ行動判定フラグ（ダッシュ中にしゃがんだか否かの判定を行う。2系のvel設定に使用する。）
; var(32)  - ステップ中ジャンプ開始判定フラグ（フルムーン専用）
; var(33)  - EXガード成否判定フラグ
; var(34)  - EXガード成立フラグ
; var(35)  - ダウン追撃フラグ
; var(36)  - MCゲージ回復実施済みフラグ（MBAACC仕様）
; var(37)  - 飛び越し判定フラグ（★421EX無敵判定にも流用）
; var(38)  - 壁バウンド時、相手側Y軸値スタック
; var(39)  - 心空妙有中背景黒化フラグ
; var(40)  - イントロ動作ヘルパー終了フラグ　※クリアすると再度イントロムーバーが生成されるためクリアしない
; var(41)  - イントロムーバー終了時エレメント番号
; var(42)  - イントロムーバー vel X
; var(43)  - イントロムーバー vel Y
; var(44)  - イントロムーバー time
; var(45)  - イントロムーバー 相手追い越し判定
; var(46)  - イントロムーバー終了時アニメ番号
; var(47)  - レバーニュートラル判定フラグ
; var(48)  - 空中ナイフキャッチ判定フラグ
; var(49)  - シールドキャンセルによるダメージ補正有無判定フラグ
; var(50)  - 214A追加仰け反り謎判定フラグ
; var(51)  - AD暗転前のサキスパ発動可否判定（暗転前に攻撃を食らった場合はサキスパは発動しないのを再現する）
; var(52)  - MCゲージ座標　X軸（ユーザ設定）
; var(53)  - MCゲージ座標　Y軸（ユーザ設定）
; var(54)  - ガードゲージ座標　X軸（ユーザ設定）
; var(55)  - ガードゲージ座標　Y軸（ユーザ設定）
; var(56)  - 勝利or敗北時、MAX/HEAT/BLOOD HEAT発動中フラグ（1:MAXで試合終了 2:HEAT/BLOOD HEATで試合終了）
; var(57)  - 擬似学習AI - 相手側攻撃種別判定スタック
; var(58)  - スタイルフラグ(1:C 2:F 3:H 4:E)
; var(59)  - AIブランク

;==============================================================================
; システム関連(fvar)
;==============================================================================
; fvar(1) - MCゲージ量
; fvar(2) - アクションゲージ数判定フラグ

; fvar(8)  - イクリプス防御係数
; fvar(9)  - ゲージ類消去フラグ
; fvar(10) - 最終補正値(ヒット数補正 * 技補正 * 状態補正)
; fvar(11) - 技補正値
; fvar(12) - 自分-相手間距離判定スタック
; fvar(13) - 重力補正
; fvar(14) - RP補正値
; fvar(15) - クリティカル補正値
; fvar(16) - mugen補正値
; fvar(17) - RP補正カウンタ
; fvar(18) - 直前のクリティカル判定
; fvar(19) - クリティカル表示フラグ
; fvar(20) - ChangeState可否(m-ism_AI)
; fvar(21) - ChangeState可否(m-ism_AI)
; fvar(22) - ChangeState可否(m-ism_AI)
; fvar(23) - ChangeState可否(m-ism_AI)
; fvar(24) - ChangeState可否(m-ism_AI)
; fvar(25) - 5030>5035遷移にかかる時間(m-ism_AI)
; fvar(26) - 5035>5050遷移にかかる時間(m-ism_AI)
; fvar(27) - 対人スイッチ(m-ism_AI)
; fvar(28) - Eベーススタイル - ジャンプ先(m-ism_AI)
; fvar(29) - Eベーススタイル(m-ism_AI)
; fvar(30) - work(m-ism_AI)
; fvar(31) - 起き攻めステップ(m-ism_AI)
; fvar(32) - ロックID(m-ism_AI)
; fvar(33) - 行動種別(m-ism_AI)
; fvar(34) - work(m-ism_AI)
; fvar(35) - work(m-ism_AI)
; fvar(36) - エリアル最低空高度(m-ism_AI)
; fvar(37) - ジャンプ連携ID(m-ism_AI)
; fvar(38) - エリアル重力(m-ism_AI)
; fvar(39) - コンボルートID/スタイル選択(m-ism_AI)

;==============================================================================
; sysvar
;==============================================================================
;sysvar(0) = デフォルトのコモン処理に使用
;sysvar(1) = デフォルトのコモン処理に使用2
;sysvar(2) = 通常技コンボフラグ(m-ism_AI)
;sysvar(3) = 必殺技コンボフラグ(m-ism_AI)
;sysvar(4) = その他コンボフラグ(m-ism_AI)

;==============================================================================
; sysfvar
;==============================================================================
;sysfvar(0) = コンボパーツID(m-ism_AI)
;sysfvar(1) = 軽量化用work(m-ism_AI)
;sysfvar(2) = コンボ始動ステート(m-ism_AI)
;sysfvar(3) = work(m-ism_AI)
;sysfvar(4) = work(m-ism_AI)

;==============================================================================
; サウンドチャンネル
;==============================================================================
; channel(1)	:ボイス分岐色々
; channel(3)	:パワー溜めボイス
; channel(4)	:ガードボイス
; channel(5)	:イントロボイス


[Data]
life = 1000
power = 3000
attack = 100
defence = 95
fall.defence_up = 50
liedown.time = 30
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 255
IntPersistIndex = 51 ;var52以降ラウンド持ち越し
FloatPersistIndex = 0

[Size]
xscale = 1.00
yscale = 1.00
ground.back = 15
ground.front = 18
air.back = 15
air.front = 15
height = 65
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -1, -87
mid.pos = -3, -61
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3
walk.back = -2
run.fwd  = 7.4, 0
run.back = -10,0
jump.neu = 0,-10.5
jump.back = -1.9
jump.fwd = 3
runjump.back = -4.5,-11
runjump.fwd = 4.5,-11
airjump.neu = 0,-5.4
airjump.back = -2.8
airjump.fwd = 2.8

[Movement]
airjump.num = 0
airjump.height = 54
yaccel = .60
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
;立ちアニメ
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State -2, イニシアティブヒート発動により来た場合]
type = VelSet
trigger1 = 1
trigger1 = prevstateno = 31125
x = 0
y = 0
ignorehitpause = 1

[State -2, イニシアティブヒート発動により来た場合]
type = PosAdd
trigger1 = time = 0
trigger1 = prevstateno = 31125
x = -20
persistent = 0
ignorehitpause = 1

[State -2, 空の境界フィニッシュ判定フラグOFF(C6CでKOした場合はクリア)]
type = VarSet
trigger1 = prevstateno = 520
trigger1 = time = 0
var(11) = 0
ignorehitpause = 1

[State 0, ござるK.O.アニメへの変更]
type = ChangeAnim
trigger1 = time = 0
trigger1 = anim != 4803
trigger1 = prevstateno != 520	;C6Cでもvar(11)を流用しているため必須
trigger1 = var(11)
value = 4803
persistent = 0

[State 0, 通常立ちアニメへの変更]
type = ChangeAnim
trigger1 = time = 0 && anim != 4803
trigger2 = anim = 5 && animtime = 0
trigger3 = anim = 4803 && animtime = 0
value = 0

[State 0, 強制解放後の30Fはアニメ停止するらしい]
type = ChangeAnim
trigger1 = anim = 0
trigger1 = Numhelper(11000)
trigger1 = helper(11000),var(1)		;強制解放後30Fは減少しないらしい
value = 0
elem = 1

[State 0, 表情差分]
type = Explod
trigger1 = !NumExplod(1)
trigger1 = time >= 12
trigger1 = timemod = 140,0
anim = 1
id = 1
pos = 0,0
postype = p1
removeongethit = 1
bindtime = 999
supermovetime = 999
sprpriority = 1
ignorehitpause = 1

[State 0, 2]
type = VelSet
trigger1 = time = 0
y = 0

[State 0, 3]
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = time = 4
x = 0

[State 0, イントロムーバーのエレメントと同期]
type = ChangeAnim
trigger1 = !Ishelper
trigger1 = Numhelper(22222)
trigger1 = time = 0
value = anim
elem = var(41)
persistent = 0

[State 0, イントロムーバー対策、透明化]
type = AssertSpecial
trigger1 = !Ishelper
trigger1 = Numhelper(22222)
trigger1 = !var(40)
flag = invisible
ignorehitpause = 1

[State 0, イントロムーバー消去]
type = DestroySelf
trigger1 = Ishelper
trigger1 = root,var(40)

[State 0, 死亡時]
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; 立ち→しゃがみ
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 振り向き]
type = Turn
trigger1 = time = 0
trigger1 = p2statetype != L
trigger1 = p2movetype != H
trigger1 = facing = enemy,facing

[State 10, イントロムーバーのエレメントと同期]
type = ChangeAnim
trigger1 = !Ishelper
trigger1 = Numhelper(22222)
trigger1 = time = 0
value = anim
elem = var(41)
persistent = 0

[State 10, 1]
type = VelMul
trigger1 = time = 0
trigger1 = !var(31)
x = 1.31

[State 10, Fのステップから]
type = VelMul
trigger1 = time = 0
trigger1 = prevstateno = 107
x = .75

[State 10, ダッシュ中しゃがみ行動判定フラグクリア]
type = VarSet
trigger1 = time = 0
trigger1 = var(31)
var(31) = 0

[State 10, ダッシュ中しゃがみ行動判定フラグON]
type = VarSet
trigger1 = time = 0
trigger1 = (prevstateno = [100,107])
var(31) = 1

[State 10, イントロムーバー消去]
type = DestroySelf
trigger1 = Ishelper
trigger1 = root,var(40)

[State 10, 2]
type = ChangeState
trigger1 = animtime = 0
value = 11

;---------------------------------------------------------------------------
; しゃがみ
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, イントロムーバー消去]
type = DestroySelf
trigger1 = Ishelper
trigger1 = root,var(40)

;---------------------------------------------------------------------------
; しゃがみ→立ち
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; 歩き
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, イントロムーバーのエレメントと同期]
type = ChangeAnim
trigger1 = !Ishelper
trigger1 = Numhelper(22222)
trigger1 = time = 0
value = anim
elem = var(41)
persistent = 0

[State 20, イントロムーバー消去]
type = DestroySelf
trigger1 = Ishelper
trigger1 = root,var(40)

;---------------------------------------------------------------------------
; ジャンプ開始
[Statedef 40]
type    = S
physics = S
ctrl = 0
facep2 = 1
sprpriority = 1

[State 40, 投げ無敵]
type = NotHitBy
trigger1 = time = 0
value = SCA, AT
time = 4

[State 40, 打撃非無敵]
type = HitBy
trigger1 = time = 0
value = SCA, AA
time = 4

[State 40, 2段ジャンプ不可フラグOFF]
type = VarSet
trigger1 = time = 0
var(1) = 0

[State 40, ただし下記キャン時は2段ジャンプ不可]
type = VarSet
triggerall = time = 0
trigger1 = prevstateno = 1811 	;玻璃の月舎迦(B)
trigger2 = prevstateno = 1621 	;無明の月(EX)
trigger3 = prevstateno = 1320 	;玻璃の月(EX)
var(1) = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, Fステップ→垂直ジャンプ判定フラグOFF]
type = VarSet
trigger1 = time = 0
var(32) = 0

[State 40, Fステップ→垂直ジャンプ判定フラグON]
type = VarSet
trigger1 = time = 0
trigger1 = var(58) = 2
trigger1 = prevstateno = 107
var(32) = 1

[State 40, 垂直ジャンプアニメ]
type = ChangeAnim
trigger1 = time = 0
trigger1 = sysvar(1) = 0
value = 39

[State 40, 前ジャンプアニメ]
type = ChangeAnim
trigger1 = time = 0
trigger1 = sysvar(1) = 1
value = 40

[State 40, 後ろジャンプアニメ]
type = ChangeAnim
trigger1 = time = 0
trigger1 = sysvar(1) = -1
value = 4

[State 40, イントロムーバーのエレメントと同期]
type = ChangeAnim
trigger1 = !Ishelper
trigger1 = Numhelper(22222)
trigger1 = time = 0
value = anim
elem = var(41)
persistent = 0

[State 40, ロングジャンプ判定フラグOFF]
type = VarSet
trigger1 = time = 0
var(5) = 0

[State 40, ロングジャンプ判定フラグON]
type = VarSet
triggerall = time = 0
triggerall = prevstateno != [200,1000]	;通常技キャンセルを阻止
triggerall = sysvar(1) != -1
triggerall = var(26) <= 6		;6フレ以上下入れっぱなし時はハイジャンプ不可
trigger1 = command = "longjump"
var(5) = 1

[State 40, 垂直ハイジャンプ時はアニメ変更]
type = ChangeAnim
trigger1 = time = 0
trigger1 = anim = 39
trigger1 = var(5)
value = 44

[State 40, 4]
type = VelSet
trigger1 = var(5)			;ハイジャンプ時
trigger1 = animtime = -4
trigger2 = !var(5)			;通常ジャンプ時
trigger2 = animtime = -5
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x))*ifelse(var(5),2.5,1))
y = const(velocity.jump.y)*ifelse(var(5)&&sysvar(1)=0,1.2, ifelse(var(5)&&sysvar(1),1, 1))

[State 40, 5]
type = VelSet
trigger1 = var(5)			;ハイジャンプ時
trigger1 = animtime = -4
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
trigger2 = !var(5)			;通常ジャンプ時
trigger2 = animtime = -5
trigger2 = prevstateno = 100 ;RUN_FWD
trigger2 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, フッ！]
type = PlaySnd
trigger1 = var(5)
trigger1 = animtime = -4
trigger1 = var(0) = [1,3]	;ハイジャンプ時
trigger2 = !var(5)
trigger2 = animtime = -5
trigger2 = var(0) = [1,3]	;通常ジャンプ時
value = S100, 0

[State 40, ハイジャンプSE]
type = PlaySnd
trigger1 = var(5)
trigger1 = animtime = -4
value = S20, 2

[State 40, 垂直ハイジャンプ砂煙]
type = Explod
trigger1 = !NumExplod(10090)
trigger1 = sysvar(1) = 0
trigger1 = animtime = -4
anim = 10090
id = 10090
pos = -5,-35
postype = p1
ownpal = 1
supermovetime = 999
scale = 0.5,0.5
sprpriority = 3

[State 40, 垂直ハイジャンプ砂煙（影）]
type = Explod
trigger1 = !NumExplod(10091)
trigger1 = sysvar(1) = 0
trigger1 = animtime = -4
anim = 10091
id = 10091
pos = -5,-35
postype = p1
ownpal = 1
supermovetime = 999
scale = 0.5,0.5
sprpriority = 2

[State 40, 前方ハイジャンプ砂煙]
type = Explod
trigger1 = !NumExplod(10100)
trigger1 = sysvar(1) = 1
trigger1 = animtime = -4
anim = 10100
id = 10100
pos = -27,-20
postype = p1
ownpal = 1
supermovetime = 999
scale = 0.9,0.9
sprpriority = 3

[State 40, 前方ハイジャンプ砂煙（影）]
type = Explod
trigger1 = !NumExplod(12180)
trigger1 = sysvar(1) = 1
trigger1 = animtime = -4
anim = 12180
id = 12180
pos = -27,-20
postype = p1
ownpal = 1
supermovetime = 999
scale = 0.89,0.89
sprpriority = 2

[State 40, イントロムーバー消去]
type = DestroySelf
trigger1 = Ishelper
trigger1 = root,var(40)

[State 40, 6]
type = ChangeState
trigger1 = var(5)		;ハイジャンプ時
trigger1 = animtime = -4
trigger2 = !var(5)
trigger2 = animtime = -5	;通常ジャンプ時
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; ジャンプ中
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = time = 0
sysvar(1) = 0

[State 50, イントロムーバー消滅直後、本体振り向き]
type = Turn
trigger1 = !Ishelper
trigger1 = var(40) = 3	;イントロ動作ヘルパー消滅フラグ（本体側）
trigger1 = var(45)	;相手追い越し判定

[State 50, ジャンプ速度　イントロムーバー用]
type = VelSet
trigger1 = !Ishelper
trigger1 = time = 1
trigger1 = var(43)
x = var(42)
y = var(43)
persistent = 0

[State 50, アニメ変更 - 通常]
type = ChangeAnim
trigger1 = time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, イントロムーバーのアニメと同期]
type = ChangeAnim
trigger1 = Numhelper(22222)
trigger1 = var(46)
trigger1 = time = 0
value = var(46)
persistent = 0

[State 50, アニメ変更 - イントロムーバのバグ対処]
; def-2に記載してあるアニメのvarsetは1Fのズレがある
; イントロムーバが50になった瞬間はvar(46)は50が代入されず
; stateno40時のアニメ番号(垂直ジャンプならanim=39)が入っている
; ので、その場合はここでフェールセーフとしてジャンプアニメに変更する
type = ChangeAnim
trigger1 = time = 0
trigger1 = anim = 4 || anim = [39,40]	;ジャンプ予備モーションアニメの場合
value = ifelse(anim=39,41, ifelse(anim=40,42,43))

[State 50, イントロムーバーのエレメントと同期]
type = ChangeAnim
trigger1 = Numhelper(22222)
trigger1 = time = 0
trigger1 = var(41)
trigger1 = var(46)
value = anim
elem = var(41)
persistent = 0

[State 50, 無明の月(EX)からの減速設定 1]
type = VelSet
trigger1 = prevstateno = 31621
trigger1 = var(58) = 2 && var(25)
trigger1 = time = 0
x = 1.5

[State 50, 無明の月(EX)からの減速設定 2]
type = VelAdd
trigger1 = prevstateno = 31621
trigger1 = var(58) = 2 && var(25)
trigger1 = time = 0
y = .19

[State 50, レバー入れによる制御（前方）]
type = VelAdd
trigger1 = !var(5)
trigger1 = !var(32)	;Fのステップ中ジャンプは除外
trigger1 = 1
trigger1 = command = "holdfwd"
trigger1 = time >= 3 && time <= 15
trigger1 = anim = 41
x = .16

[State 50, レバー入れによる制御（後方）]
type = VelAdd
trigger1 = !var(5)
trigger1 = !var(32)	;Fのステップ中ジャンプは除外
trigger1 = 1
trigger1 = command = "holdback"
trigger1 = time >= 3 && time <= 15
trigger1 = anim = 41
x = -.16

[State 50, レバー入れによる制御（前方/ハイジャンプ時）]
type = VelAdd
trigger1 = var(5)
trigger1 = !var(32)	;Fのステップ中ジャンプは除外
trigger1 = 1
trigger1 = command = "holdfwd"
trigger1 = time >= 14
trigger1 = anim = 41
x = .11

[State 50, レバー入れによる制御（後方/ハイジャンプ時）]
type = VelAdd
trigger1 = var(5)
trigger1 = !var(32)	;Fのステップ中ジャンプは除外
trigger1 = 1
trigger1 = command = "holdback"
trigger1 = time >= 14
trigger1 = anim = 41
x = -.11

