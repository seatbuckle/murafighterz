;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]



[State -2, JCリセット]
type = VarSet
trigger1 = Statetype != A
var(2) = 0

[State -2, J dash Cリセット]
type = VarSet
trigger1 = Statetype != A
var(3) = 0

;コンボ補正

[state -2, ヒット数リセット]
type = varset
trigger1 = var(4) != 0
trigger1 = P2movetype != H
var(4) = 0

[state -2, ヒット数カウント]
type = varadd
trigger1 = movehit = 1
trigger2 = projhit = 1
trigger3 = numhelper(1010)
trigger3 = helper(1010),movehit
trigger4 = numhelper(1100)
trigger4 = helper(1100),movehit
var(4) = 1

[state -2, コンボ補正値リセット]
type = varset
trigger1 = RoundState = 1
trigger2 = var(4) <= 0
fvar(1) && fvar(2) = 1.0
persistent = 0
ignorehitpause = 1

[state -2, P系]
type = varset
trigger1 = StateNo = 200 || StateNo = 400 || StateNo = 600 || StateNo = 700
trigger1 = var(4) >= 0 && var(4) <= 1
fvar(1) = 1.0
persistent = 0
ignorehitpause = 1

[state -2, P系]
type = varset
trigger1 = StateNo = 200 || StateNo = 400 || StateNo = 600 || StateNo = 700
trigger1 = var(4) >= 2 && var(4) <= 14
fvar(1) = 0.6**(var(4)-1)
persistent = 0
ignorehitpause = 1

[state -2, コンボ補正値通常技１]
type = varset
trigger1 = var(4) >= 0 && var(4) <= 2
fvar(2) = 1.0
persistent = 0
ignorehitpause = 1

[state -2, コンボ補正値通常技１]
type = varset
trigger1 = StateNo=[200,9999] 
trigger1 = var(4) >= 2 && var(4) <= 14
fvar(2) = 0.8**(var(4)-2)
persistent = 0
ignorehitpause = 1

[state -2, コンボ補正値3]
type = varset
trigger1 = var(4) >= 15
trigger2 =fvar(1) * fvar(2) <= 0.2
fvar(2) = 0.2
persistent = 0
ignorehitpause = 1

[state -2, コンボ補正値3]
type = varset
trigger1 = var(4) >= 15
trigger2 =fvar(1) * fvar(2) <= 0.2
fvar(1) = 1
persistent = 0
ignorehitpause = 1

[State -2, ノックバック補正]
type = varset
trigger1 = var(4) = [0,5]
fvar(4) = 1
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(4) = [6,11]
fvar(4) = 0.95
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(4) = [11,17]
fvar(4) = 0.9
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(4) = [17,23]
fvar(4) = 0.85
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(4) = [24,28]
fvar(4) = 0.8
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(4) = [29,34]
fvar(4) = 0.7
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(4) >= 35
fvar(4) = 0.6
ignorehitpause = 1

[State -2];ゲージ上昇補正リセット
type = Varset
triggerAll = stateno !=[1350,1360]	
trigger1 = enemy,movetype != H
trigger2 = enemy,stateno = [120,155]
fvar(8)=0
ignorehitpause = 1

[State -2 , ノックバック補正リセット]
type = varset
trigger1 = p2movetype != H
trigger1 = p2stateno != [5000,5999]
trigger2 = p2stateno = 5120
trigger3 = p2stateno = [5200,5220]
trigger4 = p2stateno = 5090
fvar(4) = 1
ignorehitpause = 1

;---------------------------------ボイス・SE関連------------------------------------------

[State -2, ダメージ弱・中]
type = PlaySnd
triggerall = alive && time = 1
trigger1 = stateno = 5000
trigger1 = anim = 5000 || anim = 5001 || anim = 5010 || anim = 5011
trigger2 = stateno = 5010
trigger2 = anim = 5020 || anim = 5021
value = 300,0
channel = 0

[State -2, ダメージ強]
type = PlaySnd
triggerall = alive && time = 1
trigger1 = stateno = 5000
trigger1 = anim = 5002 || anim = 5012
trigger2 = stateno = 5010
trigger2 = anim = 5022 || anim = 5030
value = 300,0
channel = 0
;=========================================================================
[State -2, アーマーヘルパー呼び出し]
type = Helper
triggerall = !NumHelper(9000) && MoveType != H
trigger1 = StateNo = 3100 && Time = 1 ;ナインライブズ
name = "Armor"
stateno = 9000
ID = 9000
size.xscale = 1
size.yscale = 1
postype = p1
pos = 0,0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999

[State -2, アーマー中の投げ以外無敵]
type = NotHitBy
trigger1 = NumHelper(9000)
value2 = ,AA,AP
time = 2

[State -2, アーマー中に被弾した時の無敵時間延長（２重被弾抑制処置）]
type = NotHitBy
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = SCA
time = Helper(9000),GetHitVar(hitshaketime)+5

[State -2, アーマー受けした時の点滅]
type = PalFX
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
time = 5
add = 256,10,10

[State -2, アーマー受けした時のライフ減少]
type = LifeAdd
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = -1*Helper(9000),GetHitVar(damage)
absolute = 1
ignorehitpause = 1

;=========================================================================
:RC関連
;-----------------------------------------------------------------------------

[State -2, VarSet];タイム減少
Type = Varadd
Trigger1 = var(44)>0
IgnoreHitPause = 1
V = 44
Value = -1

[State -2, VarSet];RCタイミング解除
Type = Varset
Trigger1 = ctrl
IgnoreHitPause = 1
V = 13
Value = 0

[State -2, Helper];オーバースロー
type = Pause
triggerall = Var(44)>0
trigger1 = Time < 60
trigger1 = time > 1
trigger1 = GameTime % 5 = 0
time = 3 
movetime=3

[State -2, VarAdd];背景
type = BGPalFX
trigger1 = Var(44)>0
Trigger1 =1
time = 30
add = 0,0,0
mul = 156,156,156
;sinadd = 156,156,156,10
invertall = 0
color = 125

;-----------------------------------
[state -2]
type = varset
trigger1 = fvar(33) > 1.5
trigger2 = roundno = 1&&roundstate < 2
fvar(33) = 1.5
ignorehitpause = 1

[State -2]
type = varadd
triggerall = stateno != [120,159]
triggerall = life >= 1
triggerall = fvar(33) <= 1.5
trigger1 = movetype = H
trigger1 = life < var(26)
fvar(33) = ((((var(26)-life)*1.5)+100)*((gethitvar(hitcount)*0.03)+1))*0.0001

[state -2]
type = varadd
triggerall = roundstate = 2
trigger1 = (100*life/const(data.life))=[0,24]
trigger1 = fvar(33) <= 1.5
trigger1 = alive
fvar(33) = 0.0003
persistent = 1
ignorehitpause = 1

[state -2]
type = varadd
triggerall = roundstate = 2
trigger1 = (100*life/const(data.life))=[25,49]
trigger1 = fvar(33) <= 1.5
trigger1 = alive
fvar(33) = 0.0002
persistent = 1
ignorehitpause = 1

[state -2]
type = varadd
triggerall = roundstate = 2
trigger1 = (100*life/const(data.life))=[50,100]
trigger1 = fvar(33) <= 1.5
trigger1 = alive
fvar(33) = 0.0001
persistent = 1
ignorehitpause = 1

[state -2]
type = varset
trigger1 = stateno != [150,155]
trigger1 = var(26) != life
var(26) = life
ignorehitpause = 1

[state -2]
type = lifeset
triggerall = stateno = [150,155]
trigger1 = anim = [130,155]
value = var(26)
persistent = 1
ignorehitpause = 1
;-----------------------------------
;-----------------------------------
[State -2]
type = helper
trigger1 = numhelper(780+id) = 0
sprpriority = 1
postype = p1
pos = 0,0
facing = 1
keyctrl = 1
stateno = 780
ID = 780+id
supermove = 1
supermovetime = 99999
pausemovetime = 99999
ignorehitpause = 1
ownpal = 1

[State -2]
type = parentvarset
triggerall = root,var(59) <= 0
triggerall = roundstate = 2
triggerall = root,movetype = H || (root,anim = [5120,5122])&&root,animtime=0
trigger1 = command = "burst"
var(39) = root,stateno

[State -2,BlueSaicBurst];青サイクバースト
Type = ParentVarSet
Trigger1 = RoundState=2
TriggerAll=Root,MoveType=H
TriggerAll=Root,Alive
TriggerAll=Root,var(59)>0
TriggerAll=Enemy(floor(root,fvar(18))),MoveType=A
TriggerAll=!Enemy(floor(root,fvar(18))),Ctrl
TriggerAll=Enemy(floor(root,fvar(18))),StateNo!=[0,22]
TriggerAll=Enemy(floor(root,fvar(18))),StateNo!=[50,52]
TriggerAll=Enemy(floor(root,fvar(18))),StateNo!=[100,119]
TriggerAll=Root,P2BodyDist X-Enemy(floor(root,fvar(18))),vel x*(11+(Enemy(floor(root,fvar(18))),StateType=A)*12)=[-55,55]
TriggerAll=Root,P2BodyDist Y+(Enemy(floor(root,fvar(18))),vel y!=0)*(Enemy(floor(root,fvar(18))),vel y+Enemy(floor(root,fvar(18))),Const(MoveMent.YAccel)*22)*23=[-130,0]
TriggerAll=Enemy(floor(root,fvar(18))),Pos Y+(Enemy(floor(root,fvar(18))),vel y!=0)*(Enemy(floor(root,fvar(18))),vel y+Enemy(floor(root,fvar(18))),Const(MoveMent.YAccel)*22)*23<=0
TriggerAll=Enemy(floor(root,fvar(18))),AnimTime<-23||Root,var(59)<7
TriggerAll=Random<Root,var(59)*60||Root,var(59)>9
Trigger1 = Root,StateNo!=[150,155]
var(39) = Root,StateNo

[State -2,BlueSaicBurst];ぶっぱ青サイクバースト
Type = ParentVarSet
TriggerAll=RoundState=2
TriggerAll=Root,MoveType=H
TriggerAll=Root,Alive
TriggerAll=Root,var(59)=[1,9]
TriggerAll=Root,P2BodyDist X-Enemy(floor(root,fvar(18))),vel x*(11+(Enemy(floor(root,fvar(18))),StateType=A)*12)=[-55,55]
TriggerAll=Root,P2BodyDist Y+(Enemy(floor(root,fvar(18))),vel y!=0)*(Enemy(floor(root,fvar(18))),vel y+Enemy(floor(root,fvar(18))),Const(MoveMent.YAccel)*22)*23=[-130,0]
TriggerAll=Enemy(floor(root,fvar(18))),Pos Y+(Enemy(floor(root,fvar(18))),vel y!=0)*(Enemy(floor(root,fvar(18))),vel y+Enemy(floor(root,fvar(18))),Const(MoveMent.YAccel)*22)*23<=0
TriggerAll=Random<ifelse(Root,var(59)<6,Root,var(59),10-Root,var(59))*(40+(Root,StateNo=5120)*20)
TriggerAll=Root,StateNo!=[150,155]
Trigger1 = Enemy(floor(root,fvar(18))),MoveType=A
Trigger2 = Enemy(floor(root,fvar(18))),Ctrl
Trigger3 = Enemy(floor(root,fvar(18))),StateNo=[0,22]
Trigger4 = Enemy(floor(root,fvar(18))),StateNo=[50,52]
Trigger5 = Enemy(floor(root,fvar(18))),StateNo=[100,119]
var(39) = Root,StateNo

;=========================================================================

[state -2]
type = varset
triggerall = numenemy
triggerall = !enemy,hitdefattr = SCA, AT, HA, HP
triggerall = p2stateno != [3000,4999]
trigger1 = stateno = 5120
trigger2 = stateno = 5040
trigger3 = stateno = [5200,5210]
trigger4 = movetype != H
trigger5 = stateno = [5000,5110]
trigger5 = time = 1
trigger5 = hitshakeover = 0
var(38) = 0

[state -2]
type = varset
trigger1 = numenemy
trigger1 = enemy,hitdefattr = SCA, AT, HA, HP
trigger2 = p2stateno = [3000,4999]
trigger2 = p2movetype = A
trigger3 = gethitvar(isbound)=1
;trigger1 = movetype = H
var(38) = 1
persistent = 1
ignorehitpause = 1
;========================================================================

;-----------------------------------
[State -2]
type = helper
trigger1 = numhelper(4500+id) = 0
sprpriority = 1
postype = p1
pos = 0,0
facing = 1
keyctrl = 1
stateno = 4500
ID = 4500+id
supermove = 1
supermovetime = 99999
pausemovetime = 99999
ignorehitpause = 1
ownpal = 1


;=========================================================================

[state -2]
type = varset
triggerall = numenemy
triggerall = !enemy,hitdefattr = SCA, AT, HA, HP
triggerall = p2stateno != [3000,4999]
trigger1 = stateno = 5120
trigger2 = stateno = 5040
trigger3 = stateno = [5200,5210]
trigger4 = movetype != H
trigger5 = stateno = [5000,5110]
trigger5 = time = 1
trigger5 = hitshakeover = 0
var(38) = 0

[state -2]
type = varset
trigger1 = numenemy
trigger1 = enemy,hitdefattr = SCA, AT, HA, HP
trigger2 = p2stateno = [3000,4999]
trigger2 = p2movetype = A
trigger3 = gethitvar(isbound)=1
;trigger1 = movetype = H
var(38) = 1
persistent = 1
ignorehitpause = 1

[state -2]
type = assertspecial
trigger1 = numexplod(4506+root,id) = 1
trigger2 = numexplod(4507+root,id) = 1
flag = Nomusic
ignorehitpause = 1
;-----------------------------------

[State -2,先行入力受付ヘルパー呼び出し];StateDef -2に置く
type=helper
trigger1 = !Ishelper;自分がヘルパーではない時
trigger1 = Alive;自分が生きている時
trigger1 = RoundState < 3;イントロ～戦闘中
Trigger1 = !NumHelper(60000);先行入力ヘルパーが存在しない時
helpertype = normal
name="Cmd"
stateno=60000
ID=60000
pos=9999,9999
keyctrl=0
pausemovetime=2147483647
supermovetime=2147483647
ignorehitpause = 1

;念のため関係無いステートに行かないように↓も付けておく
[State -2, helper]
type = changestate
trigger1 = Ishelper(60000)
trigger1 = !(stateno = 60000)
value = 60000
ignorehitpause = 1



;-----------------------------------
;ここは「パワー溜め」のステートで発生させた「Explod」のエフェクト画像を
;特定の条件が有効になれば消す、という処理をしています。

[State -2, エフェクトを消す];パワー溜めステート用
type = RemoveExplod
triggerall = NumExplod(130) > 0
                          ;↑はＩＤナンバー「130」のExplodの画面中の数が0よりも多い、
                          ;つまり１枚以上表示されている時
trigger1 = StateNo != 700 ;ステートが７００（パワー溜め）以外の時
trigger2 = MoveType != I  ;MoveTypeが「I（何もしてない）」以外の時
ID = 130                  ;消すExplodの特定のＩＤナンバーを指定

;-----------------------------------
[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
text = "Cancel=%d, Throw=%d, Button=%d, Body-Distance X=%d,Y=%d \n"
params = var(46),inguarddist,var(5),floor(P2BodyDist X),floor(P2BodyDist Y)

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "Position X=%d,Y=%d, Velocity X=%f,Y=%f, Hit=%d \n"
params = floor(Pos X),floor(Pos Y),(Vel X),(Vel Y),(MoveHit)


 

;===========================================================================
; 準常時監視ステート（－３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

;-----------------------------------
;ここは「ジャンプ」か「バックステップ」をした後に
;着地する音を鳴らす設定をしています。

[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;着地ステート
trigger2 = stateno = 106 ;バックステップ後の着地ステート
value = 100, 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; ■最後に『コモンステート』について■
; コモンステートとは、全キャラ共通の基本動作のステートです。
; 通常は特に変更しない限り、M.U.G.E.N本体のdataフォルダにある
;「common1.cns（コモンステートファイル）」を使います。
;
; しかし、もしもあなたのキャラのステートファイルでcommon1.cnsと同じ番号の
; 基本動作のステートを作った場合は処理が上書きされ、
; common1.cns側の同じ番号のステートは無効になります。
;
; common1.cnsのプログラム優先度は最低に属しているので、
; ステートの作成には番号に注意しないといけません。
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
