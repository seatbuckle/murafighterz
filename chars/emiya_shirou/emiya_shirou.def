; サンプルキャラクター『カンフーマン』の定義ファイルです。
; キャラクターに必要なファイルを全て登録してください。
;
; ※説明文などで左の部分に半角でセミコロン（;）が付いていますが、
; 　これが付いた後の行や文章は全て『コメント化』されます。
; （プログラムとして処理はされない）
; 　作成中のメモを残しておいたり、ステート間の区切りを設ける時などに便利です。
;
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "emiya_shirou"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "emiya_shirou"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 04,03,2025     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,03,2014     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "aka65535"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1        ;ＣＰＵで出てきた時のカラーパレットの順番

;--| 必要なファイルの設定 |---------------------------------------------------
;
; def・sff・snd・act以外のファイルは全てメモ帳などで書き換えられる
; テキスト形式のファイルなので、拡張子は何でもＯＫです。
; しかしファイルの認識で不正終了が起こる可能性もあるので、
; 無難に行くならM.U.G.E.Nでサポートされている拡張子にしておきましょう。
;
; def（定義ファイル）のみ、テキスト形式のファイルですが拡張子の変更は不可です。
;
; ※StCommonは書き換えない限り、dataフォルダにある「common1.cns」を
; 　直接読み込んでますが、あなたが独自に作ったコモンファイルを設定する場合は
; 　各キャラクターの「defファイルのあるフォルダ」を基準に
; 　ディレクトリ階層が認識されます。
;
;-----------------------------------------------------------------------------

[Files]
cmd      = emiya_shirou.cmd       ;コマンドファイルの登録
cns      = emiya_shirou.cns       ;コンスタンツファイルの登録
st       = emiya_shirou.cns       ;ステートファイルの登録・最大１１個まで増やせます
st1      = emiya_shirou_N.cns
st2      = emiya_shirou_S.cns
st3      = emiya_shirou_-2.cns
st4      = emiya_shirou_ex.cns
st5      = emiya_shirou_H.cns
st6      = emiya_shirou_ubw.cns
st7      = emiya_shirou_helper.cns
                       ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                        ;「St」のみ必要な項目なので省略出来ません
stCommon = common.cns  ;コモンステートファイルの登録
sprite   = emiya_shirou.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
anim     = emiya_shirou.air       ;アニメーションファイルの登録
sound    = emiya_shirou.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録

;--| カラーパレットファイル |-------------------------------------------------
;
; キャラクターの色を定義するファイルは最大１２個まで登録が可能です。
;
; なお、Pal7～12（７Ｐ～１２Ｐカラー）を選びたい時は、
; スタートボタン（Ｓボタン）を押しながらキャラクターを決定すれば使えます。
; この要素を利用して『裏キャラ』や『殺意の波動に目覚めたリュウ』などの
; 別性能バージョンも１体のキャラの中で作る事が可能。
;
;-----------------------------------------------------------------------------

Pal1 = emiya_shirou.act  ;Ａボタンで決定した色が使えます


;--| ストーリーボード設定 |---------------------------------------------------
;
; キャラクター固有のオープニングやエンディングのファイル（ストーリーボード）を
; 登録する場合はここで設定をします。
;
; ※ここで設定したストーリーボードが有効になるゲームモードは
; 「アーケードモード（ARCADE）」
; 「チームアーケードモード（TEAM ARCADE）」
; 「１Ｐと２ＰがペアになってＣＰＵと闘うモード（TEAM CO-OP）」の三種類のみ。
;
; 　しかしチームを組んだ場合、有効になるのは『選んだ最初の一人目』のみ。
;
;-----------------------------------------------------------------------------

[Arcade]
Intro.Storyboard = 
Ending.Storyboard = 

