Trigger1 = Time = 0
var(1) = 0

[State 205, 2];ヒットエフェクト
type = Explod
trigger1 = movehit
anim = 6000
pos = -10, -70
Postype = p2
facing = -1
sprpriority = 9
random = 5, 15
ownpal = 1
ontop = 1
pausemovetime = 99999
supermovetime = 99999
supermove = 1
bindtime = 1
persistent = 0
ignorehitpause = 1
scale = 0.5,0.5

[State 205, ヒット定義]
type = HitDef
trigger1 = AnimElemtime(4) >= 0 && animelemtime(6) < 0 && !movecontact && !movereversed
attr = S, NA ;立ち通常打撃（Standing, Normal Attack）
damage = 56 * (fvar(1)) * (fvar(2)), 0
animtype = Hard
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 14, 8
sparkno = -1
sparkxy = -10, -76
hitsound = S201, 3
guardsound = S201, 9
ground.type = high
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = -8,-7
guard.velocity = -7
airguard.velocity = -5, -4
air.type = High
air.velocity = -5,-4*fvar(4)
air.hittime = 12
fall = 1
p2stateno = 206 ;この攻撃がヒットすれば相手は↓の[Statedef 206]へ
p2facing = 1     ;相手の向きを指定
getpower = 0,0
givepower =0,0

[State 205];RCセット
type = Varset
trigger1 =AnimElem = 5
v = 13
value = 1
persistent = 0
ignorehitpause = 1

[State -1,キャンセルフラグ]
Type = VarSet
Trigger1 = MoveContAct
var(1) = 1
persistent = 0
ignorehitpause = 1

[State 205, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
[Statedef 206] 
type    = A
movetype= H
physics = N
velset = 0,0

[State 206, 相手のアニメ変更]
type = ChangeAnim2
trigger1 = 1
value = 206

[State 206, ステート変更]
type = ChangeState
trigger1 = HitShakeOver = 1 ;ヒット硬直が解けたら
value = 207
;---------------------------------------------------------------------------
[Statedef 207] 
type    = A
movetype= H
physics = N
velset = -8.5,-7

[State 207, 速度加算];重力
type = gravity
trigger1 = 1

[State 207, スクロール]
type = ScreenBound
triggerall = Pos y < -15
trigger1 = BackEdgeBodyDist < 5
trigger2 = FrontEdgeBodyDist < 5
value = 1         ;画面スクロールの影響を受けるか否か。0=受けない・1=受ける
movecamera = 0,1  ;カメラの動きをキャラに依存させるか否か。0=させない・1=させる（Ｘ軸,Ｙ軸）

[State 207, ステート変更];壁に激突するステートへ
type = ChangeState
triggerall = Pos y < -15
trigger1 = BackEdgeBodyDist <= 5
trigger2 = FrontEdgeBodyDist <= 5
value = 208

[State 207, 相手ステートに戻す]
type = SelfState
trigger1 = (Vel y > 0) && (Pos y >= 0)
value = 5100


;---------------------------------------------------------------------------
[Statedef 208] 
type    = A
movetype= H
physics = N
velset = 5,-8.5

[State 208, 振り返る]
type = Turn
trigger1 = (Time = 0) && (FrontEdgeBodyDist <= 30)

[State 208, 軸位置移動]
type = PosAdd
trigger1 = Time = 0
x = 15 - BackEdgeBodyDist

[State 208, 位置固定]
type = PosFreeze
trigger1 = 1
x = 1
y = 1

[State 208, EnvShake]
type = EnvShake
trigger1 = time = 0
time = 15
freq = 60
ampl = -4
phase = 0
persistent = 0

[State 208, スクロール]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,1

[State 208, エフェクト]
type = Explod
trigger1 = Time = 0
anim = F72
pos = 0, floor(screenpos y) - 50 ;（※５）
postype = back
sprpriority = 3

[State 208, 相手のアニメ変更]
type = ChangeAnim2
trigger1 = Time = 0
value = 208

[State 208, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = F7,0

[State 208, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 209

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
[Statedef 209]
type    = A
movetype= H
physics = N

[State 209, 移動速度]
type = VelSet
trigger1 = Time = 0
y = -6

[State 209, 移動速度]
type = VelSet
trigger1 = Time = 0
x = 0.8

[State 209, 振り返る]
type = Turn
trigger1 = (Time = 0) && (BackEdgeDist < 30)

[State 209, 速度加算];重力
type = VelAdd
trigger1 = 1
y = .67

[State 209, アニメ変更]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = !SelfAnimExist(5052) ;「!」が付いてるので、[Begin Action 5052]が無い場合
value = 5050

[State 209, アニメ変更]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5052)  ;airファイルに[Begin Action 5052]が存在してれば
value = 5052

[State 209, アニメ変更]
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5050
trigger1 = SelfAnimExist(5060)
persistent = 0
value = 5060

[State 209, アニメ変更]
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5052
trigger1 = SelfAnimExist(5062)
persistent = 0
value = 5062

[State 209, 相手ステートに戻す]
type = SelfState
trigger1 = (Vel y > 0) && (Pos y >= 0)
value = 5100

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; 下の「立ち強パンチ」のステートを見てみましょ。
;
;「Width」のコントローラは相手や画面端を押すための『物理的な幅』を
; 一時的に伸ばしたり縮ませたりする命令。
; キャラの幅はバトル中に「Ctrl+C」を押して「判定ボックス」を表示させてる時に
; 一緒に確認出来る。「軸位置から伸びる黄緑色の線」がその幅。
;
; 後は「ChangeAnim」を使って５枚目で攻撃を当てたらすぐに６枚目に
; コマを進ませる命令をしてたり、
;『画像表示優先度』で「振りかぶる時は奥」「振り切った直後から手前」に
; モーション表示の操作をしてるくらいで、難しくない処理。
;
; これは余談だけど、Widthの読み方は「ウィッズ」。
; この解説文書いた時に初めて読み方知ったよ！　｡ﾟ(ﾟつД`ﾟ)ﾟ｡
;---------------------------------------------------------------------------
;立ち弱キック
[Statedef 210]
type    = S
movetype= A
physics = N
juggle  = 0
poweradd= fvar(8)
ctrl = 0
anim = 210
sprpriority = 2

[State 200 ゲージ上昇値管理]
type = Varadd
trigger1 = movehit
fvar(8) = 1*ifelse(fvar(8)<=25,1,3)
persistent = 0
ignorehitpause = 1

[State Vel,210] 
type = Velset 
trigger1 = Time = 0 && PrevStateNo = 20 
x = 0

[State Vel,210] 
type = Velmul 
triggerall = PrevStateNo != 20 
trigger1 = 1 
x = 0.9

[State 210, 画像表示優先度]
type = SprPriority
trigger1 = AnimElem = 5
value = 2

[State 210, 物理的なキャラの幅]
type = Width
trigger1 = (AnimElemTime (2) >= 0) && (AnimElemTime (7) < 0)
value = 15,0  ;この場合キャラの幅を一時的に前に１５ピクセル伸ばす事になる。
              ;値の意味は「前方のピクセル増減量,後方のピクセル増減量」

[State 210, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 2
value = 200, 2

[State 210,キャンセルフラグ初期化]
Type = VarSet
Trigger1 = Time = 0
var(1) = 0

[State 210, 2];ヒットエフェクト
type = Explod
trigger1 = movehit
anim = 6000
pos = -10, -63
Postype = p2
facing = -1
sprpriority = 9
random = 5, 15
ownpal = 1
ontop = 1
pausemovetime = 99999
supermovetime = 99999
supermove = 1
bindtime = 1
persistent = 0
ignorehitpause = 1
scale = 0.5,0.5

[State 210, ヒット定義]
type = HitDef
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(5) < 0 && !movecontact && !movereversed
attr = S, NA
animtype  = light
damage    = 29 * (fvar(1)) * (fvar(2)), 0
guardflag = MA
pausetime = 17,12
sparkno = -1
sparkxy = -10,-70
hitsound   = S201,1
guardsound = S201,9
ground.type = High
ground.slidetime = 12
ground.hittime  = 13
ground.velocity = -5.5
air.velocity = -2.5,-4*fvar(4)
getpower = 70,5
givepower =35,5

[State 210];RCセット
type = Varset
trigger1 =AnimElem = 4
v = 13
value = 1
persistent = 0
ignorehitpause = 1

[State -1,キャンセルフラグ]
Type = VarSet
Trigger1 = MoveContAct
var(1) = 1
persistent = 0
ignorehitpause = 1

[State 210, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

