trigger1 = fvar(2) != 0
id = 60
trans = addalpha 
alpha = ceil(256-fvar(2)),256

[State 0, Explod]
type = Explod
trigger1 = Time = 0
anim = 6035
pos = 0,2
scale = 0.1*sysvar(1),0.07*sysvar(1)
vel = vel x/5,-1.2
accel = 0,0.05
postype = p1
facing = 1
ownpal = 1
bindtime = 1
removetime = -2
sprpriority = 3
id = 586

[State 0, Explod]
type = ModifyExplod
trigger1 = fvar(2) != 0
id = 586
trans = addalpha 
alpha = ceil(256-fvar(2)),256

[State 5110, 8]
