triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim != [5161,5169]
trigger2 = !SelfAnimExist(5170+var(0)*10000 + (anim % 10))
value = 5170+var(0)*10000

[State 5110, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim = [5161,5169]
trigger1 = SelfAnimExist(5170+var(0)*10000 + (anim % 10))
value = 5170+var(0)*10000 + (anim % 10)

[State 5110, 4]
type = HitFallDamage
trigger1 = Time = 0

[State 5110, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5110, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 5110, 6]
type = PlaySnd
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = 7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 0, Explod]
type = Explod
ownpal = 1
trigger1 = Time = 0
trigger1 = !SysVar(0)
anim = 6007+(sysvar(1) > 5)+(sysvar(1) > 14)
