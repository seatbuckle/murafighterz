persistent = 0
triggerall = anim = [5171,5179]
triggerall = SelfAnimExist(5110+var(0)*10000 + (anim % 10))
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5110+var(0)*10000 + (anim % 10)

[State 5110, 10] ;For normal
