trigger1 = time = 1
value = S3,23

[State 0, Explod]
type = Explod
trigger1 = time = 0 && vel x = 0
anim = 6019
pos = 0,0
scale = 0.5,0.5
postype = p1
facing = 1
bindtime = 1
ownpal = 1
removetime = -2
sprpriority = 3
trans = addalpha 
