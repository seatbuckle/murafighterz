;========================<Rose>=============================
[Statedef 196]
type=A
physics=N
movetype=A
anim=196
ctrl=0
velset=0,0
sprpriority=4

[State 8090, Velocity]
type = VelSet
trigger1 = Time = 0 || (Vel Y > 0 && Pos Y >= 0)
x = Ifelse (Time = 0, Ceil(Abs((enemynear,ScreenPos X + Ifelse (Parent, StateNo = 195, 20, -20))-(ScreenPos X)))/23, 0)
y = Ifelse (Time = 0, -2, 0)

[State 0, VelAdd]
type = VelAdd
trigger1 = time >6
y = 1

[State 199, 2]
type = HitDef
triggerall = RoundState > 1 ;root, StateNo != 193
trigger1 = Time = 0
attr = A, NP;A
damage = 10, 2
animtype = Light
guardflag = MA
hitflag = MAF
priority = 2, Hit
sprpriority = 3
pausetime = 1, 1
sparkno = -1;s7000+(random%8)
guard.sparkno=s7050
sparkxy = 5, -16 ;0, 0
hitsound = S2, 1
guardsound = S6, 0
ground.type = High
ground.slidetime = 15
ground.hittime  = 10
ground.velocity = -1
airguard.velocity = -1
air.type = High
air.velocity = -1,.5
air.hittime = 10

[State 910, Hitspark]
type = Helper;Explod
helpertype = normal
trigger1 = movehit=1
stateno = 7000
pos= 5,-16;ifelse(p2dist x<0, 0, ifelse(p2dist x<20, ceil(p2dist x), 20)), 0
size.xscale = 1
size.yscale = 1
bindtime = 1
sprpriority = 5
ignorehitpause = 1
persistent = 3

[State 1051, 3]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= -10
value = 197
