trigger1 = animelem=2 && random<200 && var(1)!=2
value = S50,9+random%3
volume = 255
channel = 0
;lowpriority = -1
freqmul = 1.0
loop = 0
pan = 0
;abspan =
;ignorehitpause =
;persistent =

